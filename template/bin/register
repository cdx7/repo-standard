  .chip:hover{border-color:var(--border-strong)}
  .chip .dot{width:8px;height:8px;border-radius:50%;background:var(--sc);flex:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--sc) 20%,transparent)}
