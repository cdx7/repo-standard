#!/usr/bin/env bash
# Managed by repo-standard: read REPO-STANDARD.md at the repo root before editing, moving or
# deleting this file. sync replaces it from the standard.
# register — checks and renders a vendor-derived repo's deviations register,
# docs/official/DEVIATIONS.md (spec: repo-standard docs/AI/design/register-script-spec.md).
#   register check     # validate the register; exit 1 on problems, or STALE when the
#                      # summary block or DEVIATIONS.html needs a render
#   register render    # rewrite the summary block between the markers + DEVIATIONS.html
#   register map [--entry N | --file PATH] [--all] [--check]
#                      # list where `register N` is cited; --check exits 1 on a citation
#                      # of an entry that does not exist
#   register history <N>   # entry N's history, read from git (versions, commits, citations)
# The prose stays hand-written: the tool reads the types table, the sources table, the
# `## N. Title` entry headings and the header line under each, and generates only the
# summary block and the page. Every byte outside the markers is kept.
# Register resolution order: $REGISTER_FILE; the repo the INVOKED copy lives in
# ($0/../docs/official/DEVIATIONS.md); the cwd's git root. Source paths resolve against the
# register's folder, or against $REGISTER_BASE when set (the pre-commit hook's staged copy). A register without a
# `<!-- register:begin` marker is not yet migrated: check says so and passes, render refuses.
# Portable: bash (>= 4) + awk + coreutils, plus git for the citations. No jq. Never
# commits (you gate that).
set -euo pipefail
[ "${BASH_VERSINFO[0]:-0}" -ge 4 ] || { printf 'register: requires bash >= 4 (stock macOS ships 3.2; brew install bash)\n' >&2; exit 1; }

# Temp files and the write lock are cleaned on ANY exit, as in track (B26).
TMPF=() TMPD="" LOCKDIR="" CREC="" CSCOPE=""
cleanup(){
  [ "${#TMPF[@]}" -gt 0 ] && rm -f "${TMPF[@]}" 2>/dev/null
  [ -n "$TMPD" ] && rm -rf "$TMPD" 2>/dev/null
  [ -n "$LOCKDIR" ] && rmdir "$LOCKDIR" 2>/dev/null
  :
}
trap cleanup EXIT

err() { printf 'register: %s\n' "$*" >&2; exit 1; }
# JS double-quoted string literal from arbitrary text — track's jsstr, unchanged (B81).
jsstr() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//</\\u003c}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}; printf '"%s"' "$s"; }

# One writer at a time: mkdir is the portable atomic test-and-set (track's B46/B112).
take_lock(){
  local lock="$FILE.lock" i=0
  until mkdir "$lock" 2>/dev/null; do
    if [ ! -e "$lock" ] && [ ! -w "$(dirname -- "$FILE")" ]; then
      err "cannot create $FILE.lock — the register's directory is not writable"
    fi
    i=$((i+1))
    [ "$i" -lt 50 ] || err "register is locked by another register run ($FILE.lock exists — stale? rmdir it)"
    sleep 0.1
  done
  LOCKDIR="$lock"
}

# ── Locate the register ───────────────────────────────────────────────────────────────
resolve_file() {
  if [ -n "${REGISTER_FILE:-}" ]; then FILE="$REGISTER_FILE"
  else
    # The INVOKED copy names the repo, as in track (B19); $0 is not resolved through
    # symlinks, so a symlinked copy names the repo it is linked from.
    local sroot="" root=""
    sroot="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd || true)"
    root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$sroot" ] && [ -f "$sroot/docs/official/DEVIATIONS.md" ]; then FILE="$sroot/docs/official/DEVIATIONS.md"
    elif [ -n "$root" ] && [ -f "$root/docs/official/DEVIATIONS.md" ]; then FILE="$root/docs/official/DEVIATIONS.md"
    else FILE="${root:+$root/docs/official/DEVIATIONS.md}"
    fi
  fi
  [ -n "${FILE:-}" ] && [ -f "$FILE" ] || err "register not found: ${FILE:-<none>} (set REGISTER_FILE, or run inside a repo with docs/official/DEVIATIONS.md)"
  # A raw US byte is refused outright, as in track (B85): the records below use 0x1f
  # as their field separator, so one inside the register would shift every later field.
  local us; us="$(LC_ALL=C awk 'index($0,"\037"){print NR; exit}' "$FILE")"
  [ -z "$us" ] || err "$FILE line $us: raw 0x1f (US) byte — the parser uses it as its field separator; remove it first"
  HTML="$(dirname -- "$FILE")/DEVIATIONS.html"
}

# ── Parse ─────────────────────────────────────────────────────────────────────────────
# One pass over the register, in the C locale so lengths and offsets are bytes whatever
# the caller's locale. Emits 0x1f-separated records on stdout:
#   H title                       the H1 (page title)
#   M nbegin nend begin end       marker counts and line numbers
#   T line type meaning           a types-table row
#   S line key doc version date path
#   N line num title type status original updated source
#   E line message                a problem (sorted by line before printing)
# Fenced blocks are skipped type-aware, as in track (B84): an example quoted in the prose
# never counts as an entry, a header, a table row or a marker. Lines between the markers
# are generated output and are never parsed as input either.
read -r -d '' PARSER <<'AWK' || true
function trim(x){ gsub(/^[ \t]+|[ \t]+$/,"",x); return x }
function out(a,b,c,d,e,f,g,h,i){ print a "\037" b "\037" c "\037" d "\037" e "\037" f "\037" g "\037" h "\037" i }
function prob(ln,msg){ out("E",ln,msg) }
function isdate(d,  y,m,dd,mx){
  if(d !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) return 0
  y=substr(d,1,4)+0; m=substr(d,6,2)+0; dd=substr(d,9,2)+0
  if(m<1 || m>12 || dd<1) return 0
  mx=(m==2)?(((y%4==0 && y%100!=0) || y%400==0)?29:28):((m==4||m==6||m==9||m==11)?30:31)
  return dd<=mx
}
# Split a pipe-table row into C[1..n]; an escaped \| stays inside its cell, restored as |.
function cells(l,  n,i){
  gsub(/\\\|/,"\001",l); sub(/^\|/,"",l); sub(/\|[ \t]*$/,"",l)
  n=split(l,C,"|")
  for(i=1;i<=n;i++){ gsub(/\001/,"|",C[i]); C[i]=trim(C[i]) }
  return n
}
function blank(l){ return l ~ /^[ \t]*$/ }
# A line that starts a new block: the header paragraph must end before one (spec § 1.5).
# A setext underline or a thematic break (---, ===, ***, ___) would turn or cut the header too.
function blockstart(l){ return l ~ /^ {0,3}([-*+][ \t]|[0-9]+[.)][ \t]|#|>|<|\||```|~~~)/ || l ~ /^ {0,3}([-*+]|-+|=+|\*\*\*+|___+)[ \t]*$/ }
{ sub(/\r$/,""); L[NR]=$0 }
END{
  SEP=" · "; MID="·"
  fc=""
  for(i=1;i<=NR;i++){
    l=L[i]
    if(l ~ /^ {0,3}(```|~~~)/){ t=(l ~ /^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; F[i]=1; continue }
    F[i]=(fc!="")
  }
  nb=0; ne=0; mb=0; me=0
  for(i=1;i<=NR;i++){ if(F[i]) continue
    if(L[i] ~ /^<!-- register:begin/){ nb++; if(!mb) mb=i }
    else if(L[i] ~ /^<!-- register:end/){ ne++; if(!me) me=i } }
  out("M",nb,ne,mb,me)
  if(nb==0) exit
  if(nb>1) prob(mb,"more than one '<!-- register:begin' marker (" nb ")")
  if(ne!=1) prob(me?me:mb, (ne==0) ? "no '<!-- register:end -->' marker" : "more than one '<!-- register:end' marker (" ne ")")
  if(nb==1 && ne==1 && me<mb) prob(me,"'<!-- register:end -->' comes before '<!-- register:begin'")
  inblk=0; sec=""; ntsec=0; nssec=0; title=""; last=0
  for(i=1;i<=NR;i++){
    if(F[i]) continue
    l=L[i]
    if(nb==1 && ne==1 && mb<me){ if(i==mb){ inblk=1; continue } if(i==me){ inblk=0; continue } if(inblk) continue }
    if(l ~ /^<!-- register:(begin|end)/) continue
    if(l ~ /^# / && title==""){ title=trim(substr(l,3)) }
    if(l ~ /^##? /){
      if(l ~ /^## / && i>1 && !blank(L[i-1])) prob(i,"no blank line before this heading (Okular nests a heading that follows a line directly)")
      sec="other"
      if(l ~ /^## Types[ \t]*$/){ sec="types"; ntsec++; trow=0; if(ntsec>1) prob(i,"a second '## Types' section") }
      else if(l ~ /^## Sources[ \t]*$/){ sec="sources"; nssec++; srow=0; if(nssec>1) prob(i,"a second '## Sources' section") }
      else if(l ~ /^## [0-9]/){
        if(l !~ /^## [1-9][0-9]*\. +[^ \t]/){ prob(i,"malformed entry heading: expected '## N. Title' (N a whole number from 1, no leading zero)"); continue }
        n=l; sub(/^## /,"",n); sub(/\..*$/,"",n)
        if(length(n)>9){ prob(i,"entry number " n " is longer than 9 digits"); continue }
        n+=0; et=l; sub(/^## [0-9]+\. +/,"",et); et=trim(et)
        if(n in SEEN) prob(i,"entry " n " is numbered twice (first at line " SEEN[n] ")")
        else { SEEN[n]=i; if(n<last) prob(i,"entry " n " is out of order: it follows entry " last) }
        if(n>last) last=n
        header(i,n,et)
      }
      continue
    }
    if(sec=="types" && l ~ /^\|/){ trow++
      k=cells(l)
      if(trow==1){ if(k!=2 || C[1]!="Type" || C[2]!="Meaning") prob(i,"the types table header must be '| Type | Meaning |'"); continue }
      if(trow==2) continue
      if(k!=2){ prob(i,"types row has " k " cells, expected 2"); continue }
      ty=C[1]
      if(ty==""){ prob(i,"types row has an empty Type"); continue }
      if(index(ty,MID) || index(ty,"|")){ prob(i,"type '" ty "' contains '·' or '|'"); continue }
      if(ty in TY){ prob(i,"type '" ty "' is defined twice (first at line " TY[ty] ")"); continue }
      TY[ty]=i; out("T",i,ty,C[2])
      continue
    }
    if(sec=="sources" && l ~ /^\|/){ srow++
      k=cells(l)
      if(srow==1){ if(k!=5 || C[1]!="Key" || C[2]!="Document" || C[3]!="Version" || C[4]!="Date" || C[5]!="Path") prob(i,"the sources table header must be '| Key | Document | Version | Date | Path |'"); continue }
      if(srow==2) continue
      if(k!=5){ prob(i,"sources row has " k " cells, expected 5"); continue }
      key=C[1]
      if(key !~ /^[A-Za-z][A-Za-z0-9-]*$/){ prob(i,"source key '" key "' must be a letter followed by letters, digits or hyphens"); continue }
      if(key in KEY){ prob(i,"source key '" key "' is defined twice (first at line " KEY[key] ")"); continue }
      KEY[key]=i
      if(C[5]==""){ prob(i,"source '" key "' has no Path"); continue }
      if(C[5] ~ /^\//){ prob(i,"source '" key "' Path must be relative to the register's folder, not absolute"); continue }
      out("S",i,key,C[2],C[3],C[4],C[5])
      continue
    }
  }
  if(ntsec==0) prob(mb,"no '## Types' section (a migrated register declares its types in a table under it)")
  if(nssec==0) prob(mb,"no '## Sources' section (a migrated register declares its sources in a table under it)")
  for(u=1;u<=nut;u++) if(!(UT[u] in TY)) prob(UTL[u],"entry " UTN[u] ": type '" UT[u] "' is not in the types table")
  for(u=1;u<=nuk;u++) if(!(UK[u] in KEY)) prob(UKL[u],"entry " UKN[u] ": source key '" UK[u] "' is not in the sources table")
  if(title!="") out("H",title)
}
# The header line: the first paragraph under the entry heading, which may wrap; a blank
# line ends it (spec § 1.5). Fields in order, ' · '-separated, labels in *…:* form.
function header(h,n,et,  j,s,e,txt,lbl,rest,pos,val,V,f,a,na,q,it,key,loc,pd){
  for(j=h+1;j<=NR && blank(L[j]) && !F[j];j++);
  if(j>NR || F[j] || L[j] !~ /^\*Type:\*/){ prob(h,"entry " n ": no header line (the first paragraph under the heading must start with '*Type:*')"); return }
  s=j; txt=trim(L[j])
  for(j=s+1;j<=NR && !blank(L[j]) && !F[j];j++){
    if(blockstart(L[j])){ prob(j,"entry " n ": no blank line after the header line (this line starts a new block; without the blank line it is swallowed into the header)"); break }
    txt=txt " " trim(L[j])
  }
  split("Type Status Original Updated Source",lbl," ")
  rest=txt
  for(f=1;f<=5;f++){
    rest=trim(rest)
    if(index(rest,"*" lbl[f] ":*")!=1){ prob(s,"entry " n ": expected '*" lbl[f] ":*' as field " f " of the header (fields: Type · Status · Original · Updated · Source)"); return }
    rest=substr(rest,length("*" lbl[f] ":*")+1)
    if(f<5){ pos=index(rest,SEP); if(!pos){ prob(s,"entry " n ": no ' · ' after the " lbl[f] " field"); return }
             V[f]=trim(substr(rest,1,pos-1)); rest=substr(rest,pos+length(SEP)) }
    else V[f]=trim(rest)
  }
  if(V[1]==""){ prob(s,"entry " n ": empty Type") ; return }
  nut++; UT[nut]=V[1]; UTL[nut]=s; UTN[nut]=n
  if(V[2]!="active" && V[2]!="moot" && V[2]!="closed"){ prob(s,"entry " n ": Status '" V[2] "' is not active, moot or closed"); return }
  if(!isdate(V[3])){ prob(s,"entry " n ": Original '" V[3] "' is not a YYYY-MM-DD date"); return }
  if(V[4]!="—"){
    na=split(V[4],a,", "); pd=""
    for(q=1;q<=na;q++){
      if(!isdate(a[q])){ prob(s,"entry " n ": Updated '" a[q] "' is not a YYYY-MM-DD date (dates are separated by ', '; '—' for none)"); return }
      if(pd!="" && a[q]<=pd){ prob(s,"entry " n ": Updated dates are not in ascending order (" pd " then " a[q] ")"); return }
      pd=a[q]
    }
  }
  # 'none' stands alone: anything after it is most often the next paragraph, glued on
  # because the blank line after the header is missing.
  if(V[5] ~ /^none[ \t;]/){ prob(s,"entry " n ": Source 'none' must stand alone (is the paragraph after the header missing its blank line?)"); return }
  if(V[5]!="none"){
    na=split(V[5],a,"; ")
    for(q=1;q<=na;q++){
      it=a[q]; pos=index(it," ")
      key=pos?substr(it,1,pos-1):it; loc=pos?trim(substr(it,pos+1)):""
      if(key !~ /^[A-Za-z][A-Za-z0-9-]*$/ || loc==""){ prob(s,"entry " n ": Source item '" it "' is not '<key> <location>' (items are separated by '; '; 'none' when no vendor document addresses the point)"); return }
      nuk++; UK[nuk]=key; UKL[nuk]=s; UKN[nuk]=n
    }
  }
  out("N",h,n,et,V[1],V[2],V[3],V[4],V[5])
}
AWK

# parse → globals: TITLE, NB/MB/ME, arrays of records, PROBS (sorted "line<TAB>msg").
parse() {
  local kind a b c d e f g h
  TITLE="" NB=0 MB=0 ME=0
  TYPES_R=() SOURCES_R=() ENTRIES_R=() PROBS=()
  local PBASE="${REGISTER_BASE:-$(dirname -- "$FILE")}"
  local probs="" recs
  recs="$(LC_ALL=C awk "$PARSER" "$FILE")" || err "the parser failed on $FILE (awk exit $?)"
  while IFS=$'\037' read -r kind a b c d e f g h; do
    [ -n "$kind" ] || continue
    case "$kind" in
      H) TITLE="$a" ;;
      M) NB="$a" MB="$c" ME="$d" ;;   # $b, the end-marker count, is checked in the parser
      T) TYPES_R+=("$a"$'\037'"$b"$'\037'"$c") ;;
      S) SOURCES_R+=("$a"$'\037'"$b"$'\037'"$c"$'\037'"$d"$'\037'"$e"$'\037'"$f")
         # Paths are checked here (awk has no portable file test), relative to the
         # register's folder — or to $REGISTER_BASE, which the pre-commit hook sets to the
         # worktree register's folder while it checks a staged copy from a temp dir.
         [ -e "$PBASE/$f" ] || probs+="$a"$'\t'"source '$b' Path does not exist: $f (relative to $PBASE)"$'\n' ;;
      N) ENTRIES_R+=("$a"$'\037'"$b"$'\037'"$c"$'\037'"$d"$'\037'"$e"$'\037'"$f"$'\037'"$g"$'\037'"$h") ;;
      E) probs+="$a"$'\t'"$b"$'\n' ;;
    esac
  done <<<"$recs"
  [ -n "$probs" ] && mapfile -t PROBS < <(printf '%s' "$probs" | sort -s -t$'\t' -k1,1n)
  :
}

print_probs() {
  local p
  for p in "${PROBS[@]}"; do printf '%s:%s: %s\n' "$FILE" "${p%%$'\t'*}" "${p#*$'\t'}" >&2; done
  printf 'register: %d problem(s) in %s\n' "${#PROBS[@]}" "$FILE" >&2
}

# Table cell: escape a bare | (an already escaped \| is kept as it is).
cell() {
  local s=$1 o="" ch prev=""
  while [ -n "$s" ]; do
    ch="${s:0:1}"; s="${s:1}"
    if [ "$ch" = "|" ] && [ "$prev" != "\\" ]; then o+="\\|"; else o+="$ch"; fi
    prev="$ch"
  done
  printf '%s' "$o"
}

# ── Generate: the summary block and the page, into the two paths given ─────────────────
generate() {  # $1 = new register path, $2 = new DEVIATIONS.html path
  local newreg=$1 newhtml=$2 r n t ty st og up so cr=""
  local IFS0=$IFS
  # A CRLF register gets CRLF block lines, so the file does not end up with mixed endings.
  if LC_ALL=C sed -n "${MB}p" "$FILE" | LC_ALL=C grep -q $'\r$'; then cr=$'\r'; fi
  {
    head -n "$MB" "$FILE"
    printf '%s\n' "$cr"
    printf '| # | Deviation | Type | Status | Original | Updated | Source |%s\n' "$cr"
    # Plain dashes, no alignment colons (B150): an aligned cell carries an inline style, and
    # ReText's default preview (Qt's rich-text engine) then drops its table border.
    printf '| --- | --- | --- | --- | --- | --- | --- |%s\n' "$cr"
    for r in "${ENTRIES_R[@]}"; do
      IFS=$'\037' read -r _ n t ty st og up so <<<"$r"; IFS=$IFS0
      printf '| %s | %s | %s | %s | %s | %s | %s |%s\n' "$n" "$(cell "$t")" "$(cell "$ty")" "$st" "$og" "$up" "$(cell "$so")" "$cr"
    done
    printf '%s\n' "$cr"
    tail -n +"$ME" "$FILE"
  } > "$newreg" || return 1

  # The page's data block. The title comes from the register's own H1, so a render of a
  # copy elsewhere (the pre-commit hook's staged copy) is byte-identical (track's B22).
  local data="" k doc ver dat pth mean items it rest loc upd
  data+="const META = {title:$(jsstr "${TITLE:-(untitled)}")};"$'\n'
  data+="const TYPES = ["$'\n'
  for r in "${TYPES_R[@]}"; do
    IFS=$'\037' read -r _ ty mean <<<"$r"; IFS=$IFS0
    data+="  {type:$(jsstr "$ty"),meaning:$(jsstr "$mean")},"$'\n'
  done
  data+="];"$'\n'"const SOURCES = ["$'\n'
  for r in "${SOURCES_R[@]}"; do
    IFS=$'\037' read -r _ k doc ver dat pth <<<"$r"; IFS=$IFS0
    data+="  {key:$(jsstr "$k"),doc:$(jsstr "$doc"),version:$(jsstr "$ver"),date:$(jsstr "$dat"),path:$(jsstr "$pth")},"$'\n'
  done
  data+="];"$'\n'"const ENTRIES = ["$'\n'
  for r in "${ENTRIES_R[@]}"; do
    IFS=$'\037' read -r _ n t ty st og up so <<<"$r"; IFS=$IFS0
    # Split as the parser does: Source items on '; ' (key, then the location after the
    # first space), Updated dates on ', '.
    items=""
    if [ "$so" != "none" ]; then
      rest="$so"
      while :; do
        it="${rest%%; *}"; loc="${it#* }"; loc="${loc#"${loc%%[! ]*}"}"; loc="${loc%"${loc##*[! ]}"}"
        items+="{key:$(jsstr "${it%% *}"),loc:$(jsstr "$loc")},"
        [ "$rest" = "$it" ] && break; rest="${rest#*; }"
      done
    fi
    upd=""
    if [ "$up" != "—" ]; then
      rest="$up"
      while :; do it="${rest%%, *}"; upd+="$(jsstr "$it"),"; [ "$rest" = "$it" ] && break; rest="${rest#*, }"; done
    fi
    data+="  {n:$n,title:$(jsstr "$t"),type:$(jsstr "$ty"),status:$(jsstr "$st"),original:$(jsstr "$og"),updated:[$upd],sources:[$items]},"$'\n'
  done
  data+="];"$'\n'"$(cites_js "$CSCOPE")"

  local title; title="$(printf '%s' "${TITLE:-(untitled)}" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"
  local datafile="$newhtml.data"; printf '%s\n' "$data" > "$datafile" || return 1
  # Both substitutions ride ENVIRON and index/substr, never awk -v or gsub (track's B48/B49).
  TITLEV="$title" DF="$datafile" awk '
      /^\/\/__DATA__\/\/$/{ while((getline l < ENVIRON["DF"])>0) print l; close(ENVIRON["DF"]); next }
      { out=""; rest=$0
        while((i=index(rest,"__TITLE__"))>0){ out=out substr(rest,1,i-1) ENVIRON["TITLEV"]; rest=substr(rest,i+9) }
        print out rest }' > "$newhtml" <<'HTML' || return 1
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>register — __TITLE__</title>
<style>
  *{box-sizing:border-box}
  :root{
    --bg:#eef0f3;--surface:#fff;--surface-2:#e7eaef;--raised:#f6f8fa;--border:#d5dae1;
    --border-strong:#c2c9d3;--text:#1a2030;--text-dim:#59626f;--text-faint:#8b93a1;
    --accent:#2f6f9f;--accent-ink:#1c5680;--accent-weak:#e3eef6;
    --shadow:0 1px 2px rgba(20,30,45,.06),0 6px 20px rgba(20,30,45,.05);
    --mono:ui-monospace,"SF Mono","JetBrains Mono",Menlo,Consolas,monospace;
    --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  @media (prefers-color-scheme:dark){:root{
    --bg:#101319;--surface:#191d25;--surface-2:#212631;--raised:#232a36;--border:#2f3743;
    --border-strong:#3c4552;--text:#e7ebf1;--text-dim:#9aa4b2;--text-faint:#6b7686;
    --accent:#6fb7e8;--accent-ink:#a7d3f2;--accent-weak:#182634;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.28);}}
  :root[data-theme="light"]{--bg:#eef0f3;--surface:#fff;--surface-2:#e7eaef;--raised:#f6f8fa;--border:#d5dae1;--border-strong:#c2c9d3;--text:#1a2030;--text-dim:#59626f;--text-faint:#8b93a1;--accent:#2f6f9f;--accent-ink:#1c5680;--accent-weak:#e3eef6;--shadow:0 1px 2px rgba(20,30,45,.06),0 6px 20px rgba(20,30,45,.05)}
  :root[data-theme="dark"]{--bg:#101319;--surface:#191d25;--surface-2:#212631;--raised:#232a36;--border:#2f3743;--border-strong:#3c4552;--text:#e7ebf1;--text-dim:#9aa4b2;--text-faint:#6b7686;--accent:#6fb7e8;--accent-ink:#a7d3f2;--accent-weak:#182634;--shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.28)}
  body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}
