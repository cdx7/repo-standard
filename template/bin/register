    <label class="search">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="q" type="search" placeholder="Filter by number, title or citing file…" autocomplete="off" aria-label="Filter entries">
    </label>
    <div class="sortbox"><span>Sort</span>
      <select id="sortKey" aria-label="Sort column">
        <option value="n">#</option><option value="title">Deviation</option><option value="type">Type</option>
