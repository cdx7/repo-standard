<script>
  const STCOLOR={active:"#3b82f6",moot:"#f59e0b",closed:"#6b7280"};
  const STORDER=["active","moot","closed"];
  const PALETTE=["#8b5cf6","#06b6d4","#f97316","#22c55e","#ec4899","#eab308","#14b8a6","#a855f7","#ef4444","#64748b"];
  const TYCOLOR={};TYPES.forEach((t,i)=>TYCOLOR[t.type]=PALETTE[i%PALETTE.length]);
  const SRC={};SOURCES.forEach(s=>SRC[s.key]=s);
  const NONE="none";
  const state={q:"",status:new Set(),type:new Set(),key:new Set(),sortKey:"n",dir:1,expanded:new Set()};
  const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  // The heading's own inline Markdown, enough to read: code spans, bold, strike-through.
  function md(s){return String(s).split("`").map((p,i)=>i%2?`<code>${esc(p)}</code>`:esc(p).replace(/\*\*([^*]+)\*\*/g,"<strong>$1</strong>").replace(/~~([^~]+)~~/g,"<s>$1</s>")).join("")}
  const plain=s=>String(s).replace(/[`*~]/g,"");
  const href=p=>p.split("/").map(encodeURIComponent).join("/");
  const keysOf=e=>e.sources.length?e.sources.map(s=>s.key):[NONE];
  const lastUpd=e=>e.updated.length?e.updated[e.updated.length-1]:"";
  const so=s=>{const i=STORDER.indexOf(s);return i<0?STORDER.length:i};
  const citesOf=e=>CITES[String(e.n)]||[];
  // Citations are as of the last render, from the live files (spec § 2, Q3).
  function citedBy(e){
    if(!CITE_SCOPE)return `<span class="none">not collected: the page was rendered outside a git work tree</span>`;
    const c=citesOf(e);if(!c.length)return `<span class="none">not cited in the ${esc(CITE_SCOPE)}</span>`;
    const by={},order=[];c.forEach(([f,l])=>{if(!(f in by)){by[f]=[];order.push(f)}by[f].push(l)});
    return `<ul>${order.map(f=>`<li><code>${esc(f)}</code> ${by[f].length>1?'lines':'line'} ${by[f].join(", ")}</li>`).join("")}</ul>`
      +(e.status==="closed"?`<div class="warn">Entry ${e.n} is closed: check whether these citations still apply.</div>`:"")}
  const tyo=t=>{const i=TYPES.findIndex(x=>x.type===t);return i<0?TYPES.length:i};

  function match(e){
    if(state.status.size&&!state.status.has(e.status))return false;
    if(state.type.size&&!state.type.has(e.type))return false;
    if(state.key.size&&!keysOf(e).some(k=>state.key.has(k)))return false;
    if(state.q){const q=state.q.toLowerCase();if(!(String(e.n)===q.replace(/^#/,"")||plain(e.title).toLowerCase().includes(q)||citesOf(e).some(c=>c[0].toLowerCase().includes(q))))return false}
    return true}
  function cmp(a,b){let r=0;const k=state.sortKey;
    if(k==="n")r=a.n-b.n;else if(k==="title")r=plain(a.title).toLowerCase().localeCompare(plain(b.title).toLowerCase());
    else if(k==="type")r=tyo(a.type)-tyo(b.type);else if(k==="status")r=so(a.status)-so(b.status);
    else if(k==="original")r=a.original<b.original?-1:a.original>b.original?1:0;
    else if(k==="updated"){const x=lastUpd(a),y=lastUpd(b);r=x<y?-1:x>y?1:0}
    return (r||a.n-b.n)*state.dir}

  function chipRow(label,group,items){
    const counts={};ENTRIES.forEach(e=>{(group==="key"?keysOf(e):[e[group]]).forEach(v=>counts[v]=(counts[v]||0)+1)});
    const set=state[group];
    return `<div class="chips"><span class="lbl">${esc(label)}</span>`+items.map(([v,color,shown])=>{const on=set.has(v);
      return `<button class="chip ${on?'on':''}" style="--sc:${color}" data-g="${group}" data-v="${esc(v)}" aria-pressed="${on}"><span class="dot"></span>${esc(shown)} <span class="n">${counts[v]||0}</span></button>`}).join("")
      +(set.size?`<button class="btn clr" data-g="${group}">clear</button>`:"")+`</div>`}
  function renderChips(){
    // Values the tables do not declare (hand-edited, not yet re-checked) still get chips.
    const st=STORDER.concat([...new Set(ENTRIES.map(e=>e.status))].filter(s=>!STORDER.includes(s)).sort());
    const ty=TYPES.map(t=>t.type).concat([...new Set(ENTRIES.map(e=>e.type))].filter(t=>!(t in TYCOLOR)).sort());
    const used=new Set(ENTRIES.flatMap(keysOf));
    const ks=SOURCES.map(s=>s.key).concat([...used].filter(k=>k!==NONE&&!(k in SRC)).sort()).concat(used.has(NONE)?[NONE]:[]);
    const el=document.getElementById("chips");
    el.innerHTML=chipRow("Status","status",st.map(s=>[s,STCOLOR[s]||"#888",s]))
      +chipRow("Type","type",ty.map(t=>[t,TYCOLOR[t]||"#888",t]))
      +chipRow("Source","key",ks.map(k=>[k,k===NONE?"#8a94a6":"var(--accent)",k]));
    el.querySelectorAll(".chip").forEach(c=>c.onclick=()=>{const s=state[c.dataset.g],v=c.dataset.v;s.has(v)?s.delete(v):s.add(v);render()});
    el.querySelectorAll(".clr").forEach(b=>b.onclick=()=>{state[b.dataset.g].clear();render()});
  }
  function detail(e){
    const ty=TYPES.find(t=>t.type===e.type);
    const srcs=e.sources.length?`<ul>${e.sources.map(s=>{const d=SRC[s.key];
      return `<li>${d?`<a href="${esc(href(d.path))}">${esc(s.key)}</a> — ${esc(d.doc)}${d.version?` ${esc(d.version)}`:''}${d.date?` (${esc(d.date)})`:''}`:esc(s.key)}: ${esc(s.loc)}</li>`}).join("")}</ul>`
      :`<span class="none">none — no vendor document addresses the point</span>`;
    return `<tr class="detail"><td colspan="7"><div class="box"><dl>
      <dt>Type</dt><dd>${esc(e.type)}${ty&&ty.meaning?` — ${esc(ty.meaning)}`:''}</dd>
      <dt>Dates</dt><dd>original ${esc(e.original)}${e.updated.length?`; updated ${e.updated.map(esc).join(", ")}`:''}</dd>
      <dt>Sources</dt><dd>${srcs}</dd>
      <dt>Cited by</dt><dd>${citedBy(e)}</dd>
      <dt>Cite as</dt><dd><code>register ${e.n}</code></dd></dl></div></td></tr>`}
  function renderRows(){
    const cols=[["n","#","c-n"],["title","Deviation","c-t"],["type","Type","c-ty"],["status","Status","c-st"],["original","Original","c-og"],["updated","Updated","c-up"],["","Source","c-so"]];
    document.getElementById("thead").innerHTML="<tr>"+cols.map(([k,l,c])=>{const act=k&&state.sortKey===k;
      return `<th class="${c} ${k?'sortable':''} ${act?'act':''}" ${k?`data-k="${k}"`:''}>${l}<span class="ar">${act?(state.dir>0?'▲':'▼'):''}</span></th>`}).join("")+"</tr>";
    const rows=ENTRIES.filter(match).sort(cmp);
    const tb=document.getElementById("rows");
    tb.innerHTML=rows.length?rows.map(e=>{const open=state.expanded.has(e.n);
      return `<tr class="row ${open?'open':''} ${e.status==='closed'?'closed':''}" data-n="${e.n}" tabindex="0" role="button" aria-expanded="${open}">
        <td class="c-n">${e.n}</td><td><div class="name"><span class="exp">▶</span><span class="ttl">${md(e.title)}</span></div></td>
        <td class="c-ty"><span class="tag" style="box-shadow:inset 3px 0 0 ${TYCOLOR[e.type]||'#888'}">${esc(e.type)}</span></td>
        <td class="c-st"><span class="pill" style="--sc:${STCOLOR[e.status]||'#888'}"><span class="dot"></span>${esc(e.status)}</span></td>
        <td class="c-og">${esc(e.original)}</td><td class="c-up">${e.updated.length?esc(lastUpd(e))+(e.updated.length>1?` <span class="none">+${e.updated.length-1}</span>`:''):'—'}</td>
        <td class="c-so">${e.sources.length?[...new Set(e.sources.map(s=>s.key))].map(esc).join(" "):'<span class="none">none</span>'}</td></tr>${open?detail(e):''}`}).join("")
      :`<tr><td colspan="7"><div class="empty">${ENTRIES.length?'No entries match the current filter.':'No entries recorded yet.'}</div></td></tr>`;
    document.getElementById("count").textContent=`${rows.length} of ${ENTRIES.length} shown`;
    document.getElementById("secn").textContent=rows.length!==ENTRIES.length?`${rows.length} / ${ENTRIES.length}`:`${ENTRIES.length}`;
    document.querySelectorAll("thead th.sortable").forEach(t=>t.onclick=()=>{const k=t.dataset.k;if(state.sortKey===k)state.dir*=-1;else{state.sortKey=k;state.dir=1}syncSort();renderRows()});
    tb.querySelectorAll("tr.row").forEach(tr=>{const n=+tr.dataset.n;const t=()=>{state.expanded.has(n)?state.expanded.delete(n):state.expanded.add(n);renderRows()};tr.onclick=t;tr.onkeydown=ev=>{if(ev.key==="Enter"||ev.key===" "){ev.preventDefault();t()}}});
  }
  function renderSources(){
    document.getElementById("srcn").textContent=SOURCES.length;
    document.getElementById("srcs").innerHTML=SOURCES.length?SOURCES.map(s=>`<tr><td class="k"><a href="${esc(href(s.path))}">${esc(s.key)}</a></td><td>${esc(s.doc)}${s.version?` <span class="none">${esc(s.version)}</span>`:''}${s.date?` <span class="none">${esc(s.date)}</span>`:''}<div class="p">${esc(s.path)}</div></td></tr>`).join("")
      :`<tr><td><div class="empty">No sources declared yet.</div></td></tr>`}
  function syncSort(){document.getElementById("sortKey").value=state.sortKey;document.getElementById("dir").textContent=state.dir>0?"↑ asc":"↓ desc"}
  function render(){renderChips();renderRows()}
  document.getElementById("q").addEventListener("input",e=>{state.q=e.target.value.trim();renderRows()});
  document.getElementById("sortKey").addEventListener("change",e=>{state.sortKey=e.target.value;state.dir=1;syncSort();renderRows()});
  document.getElementById("dir").addEventListener("click",()=>{state.dir*=-1;syncSort();renderRows()});
  // Judge "all open?" against the visible rows only (track's B83).
  document.getElementById("expandAll").addEventListener("click",()=>{const vis=ENTRIES.filter(match);const all=vis.length>0&&vis.every(e=>state.expanded.has(e.n));
    vis.forEach(e=>all?state.expanded.delete(e.n):state.expanded.add(e.n));document.getElementById("expandAll").textContent=all?"Expand all":"Collapse all";renderRows()});
  if(DANGLING.length)document.getElementById("dangling").innerHTML=`<div class="warn"><strong>${DANGLING.length} citation${DANGLING.length>1?'s name entries':' names an entry'} that ${DANGLING.length>1?'do':'does'} not exist:</strong> ${DANGLING.map(([f,l,n])=>`<code>${esc(f)}:${l}</code> (register ${esc(n)})`).join(", ")}. Run <code>register map</code>.</div>`;
  const nc=Object.values(CITES).reduce((a,c)=>a+c.length,0);
  document.getElementById("foot").innerHTML=`<strong>DEVIATIONS.html</strong> — generated from <code>DEVIATIONS.md</code> by <code>register render</code>. ${ENTRIES.length} entries, ${TYPES.length} types, ${SOURCES.length} sources; ${CITE_SCOPE?`${nc} citations in the ${esc(CITE_SCOPE)}, as of the last render`:"citations not collected"}. Read-only; edit the Markdown, then re-render.`;
  syncSort();renderSources();render();
</script>
</body>
</html>
HTML
  rm -f "$datafile"
}

# ── Citations ─────────────────────────────────────────────────────────────────────────
# A citation is `register N` in one of the repo's tracked files, read from the worktree.
# The default scope is the files that describe the build as it is now (spec § 2, Q3): it
# leaves out the register, the generated pages, docs/reference/, the dated records in
# docs/AI/ and z-deprecated/, which keep citing entries that have since closed. --all
# drops those exclusions for one run.
repo_root() {  # → ROOT, REGREL, HTMLREL; returns 1 when the register is not in a git work tree
  local d r
  ROOT="$(git -C "$(dirname -- "$FILE")" rev-parse --show-toplevel 2>/dev/null)" && [ -n "$ROOT" ] || return 1
  d="$(cd "$(dirname -- "$FILE")" && pwd -P)"; r="$(cd "$ROOT" && pwd -P)"
  case "$d/" in "$r/"*) ;; *) return 1 ;; esac
  d="${d#"$r"}"; d="${d#/}"; d="${d:+$d/}"
  REGREL="$d$(basename -- "$FILE")"; HTMLREL="${d}DEVIATIONS.html"
}

# The scan, over the files git grep names (binary files skipped). Emits records:
#   C file line N       a citation (once per number per line)
#   U file line text    a "DEVIATIONS applied" item that names no register entry
# `register N` matches in any case, not inside a longer word (preregister 3), and not
# when N runs on into a date or a version (register 2026-09-30, register 1.36). A
# "DEVIATIONS applied" block opens on a comment line naming it and runs to an empty
# comment line or the first non-comment line; its items are its bullets (with their
# indented continuation lines), or the text after its colon when it has no bullets.
read -r -d '' MAPPER <<'AWK' || true
function trim(x){ gsub(/^[ \t]+|[ \t]+$/,"",x); return x }
function flush(  low){
  if(cur!=""){ low=tolower(cur)
    if(low !~ /(^|[^a-z0-9_])register[ \t]+[0-9]/) print "U" "\037" cf "\037" curl "\037" (length(cur)>140 ? substr(cur,1,139) "…" : cur) }
  cur=""
}
function indent(s){ match(s,/^[ \t]*/); return RLENGTH }
FNR==1{ if(inblk) flush(); inblk=0; cf=FILENAME; sub(/^\.\//,"",cf) }
{ line=$0; sub(/\r$/,"",line); low=tolower(line)
  split("",SEEN); s=low; off=0
  while(match(s,/register[ \t]+[0-9]+/)){
    st=RSTART; ln=RLENGTH; abs=off+st
    pre=(abs>1)?substr(low,abs-1,1):""
    num=substr(s,st,ln); sub(/^register[ \t]+/,"",num)
    nx=substr(s,st+ln,2)
    if(pre !~ /[a-z0-9_]/ && nx !~ /^[.-][0-9]/){
      sub(/^0+/,"",num); if(num=="") num="0"
      if(!(num in SEEN)){ SEEN[num]=1; print "C" "\037" cf "\037" FNR "\037" num }
    }
    off=abs+ln-1; s=substr(s,st+ln)
  }
  if(inblk){
    m=line; sub(/^[ \t]+/,"",m)
    if(index(m,mk)!=1){ flush(); inblk=0 }
    else {
      body=substr(m,length(mk)+1)
      if(body ~ /^[ \t]*$/){ flush(); inblk=0 }
      # A bullet at the first bullet's indent (or less) opens an item; deeper, a line that
      # merely starts with - * + is a continuation ("#     + actions-api warms)").
      else if(body ~ /^[ \t]*[-*+][ \t]/ && (!bul || indent(body)<=bind)){ flush(); if(!bul) bind=indent(body); cur=body; sub(/^[ \t]*[-*+][ \t]+/,"",cur); cur=trim(cur); curl=FNR; bul=1 }
      else if(bul && indent(body)<=hind){ flush(); inblk=0 }   # back at the header's level: a new paragraph
      else if(cur!="") cur=cur " " trim(body)
    }
  }
  if(!inblk && match(line,/^[ \t]*[^ \tA-Za-z0-9]+[ \t]*DEVIATIONS applied/)){
    m=line; sub(/^[ \t]+/,"",m); match(m,/^[^ \tA-Za-z0-9]+/); mk=substr(m,1,RLENGTH)
    r=substr(m,RLENGTH+1); hind=indent(r)
    sub(/^[ \t]*DEVIATIONS applied/,"",r); sub(/^[ \t]*\([^)]*\)/,"",r); sub(/^[ \t]*:/,"",r); r=trim(r)
    inblk=1; bul=0; cur=""
    if(r!="" && tolower(r) !~ /^none([^a-z]|$)/){ cur=r; curl=FNR }
  }
}
END{ if(inblk) flush() }
AWK

collect() {  # $1 = 1 for --all; $2 = one repo-relative file to scan alone ("" for the scope) → CREC
  local all=$1 only=$2 lst rc=0 f
  local spec=() files=() args=()
  CREC=""
  if [ -n "$only" ]; then spec=(-- "$only")
  else
    spec=(-- .)
    [ "$all" = 1 ] || spec+=(":(exclude)$REGREL" ":(exclude)$HTMLREL" ':(exclude,glob)**/tracker.html'
                             ':(exclude)docs/reference' ':(exclude)docs/AI' ':(exclude)z-deprecated')
  fi
  lst="$(mktemp)" || err "cannot create a temp file"; TMPF+=("$lst")
  git -C "$ROOT" grep -l -z -I -i -E -e '(^|[^[:alnum:]_])register[[:space:]]+[0-9]' -e 'DEVIATIONS applied' "${spec[@]}" > "$lst" 2>/dev/null || rc=$?
  [ "$rc" -le 1 ] || err "git grep failed in $ROOT (exit $rc)"
  mapfile -d '' -t files < "$lst"
  [ "${#files[@]}" -gt 0 ] || return 0
  # './' keeps a file named like 'a=b' from being read as an awk variable assignment.
  for f in "${files[@]}"; do args+=("./$f"); done
  CREC="$(cd "$ROOT" && LC_ALL=C awk "$MAPPER" "${args[@]}")" || err "the citation scan failed in $ROOT"
}

# The page's citation block, from CREC: citations of existing entries per entry, the rest
# as DANGLING. It sits between two marker lines that `check` leaves out of its comparison:
# a commit that only moves a citation must not make the page STALE (decided 2026-10-01).
cites_js() {  # $1 = scope label ("" when citations were not collected)
  local r kind f l n t _ out="" dang=""
  declare -A CI=() HAS=()
  for r in "${ENTRIES_R[@]}"; do IFS=$'\037' read -r _ n _ <<<"$r"; HAS[$n]=1; done
  while IFS=$'\037' read -r kind f l n; do
    [ "$kind" = C ] || continue
    if [ -n "${HAS[$n]:-}" ]; then CI[$n]+="[$(jsstr "$f"),$l],"
    else dang+="[$(jsstr "$f"),$l,$(jsstr "$n")],"; fi
  done <<<"$CREC"
  out+="// cites:begin — citations, as of the last render; register check does not compare these lines"$'\n'
  out+="const CITE_SCOPE = $(jsstr "$1");"$'\n'"const CITES = {"$'\n'
  for r in "${ENTRIES_R[@]}"; do
    IFS=$'\037' read -r _ n _ <<<"$r"
    [ -n "${CI[$n]:-}" ] && out+="  \"$n\":[${CI[$n]}],"$'\n'
  done
  out+="};"$'\n'"const DANGLING = [$dang];"$'\n'"// cites:end"
  printf '%s' "$out"
}
# The page minus its citation block — what `check` compares.
strip_cites() { awk '/^\/\/ cites:begin/{s=1} !s{print} /^\/\/ cites:end$/{s=0}' "$1"; }

# The map report, from CREC and the entries.
read -r -d '' REPORT <<'AWK' || true
BEGIN{ FS="\037"; mode=ENVIRON["MODE"]; want=ENVIRON["ENTRY"] }
FILENAME==ENVIRON["ENTF"]{ st[$1]=$2; ti[$1]=$3; ord[++ne]=$1; next }
$1=="C"{ f=$2; l=$3; n=$4; if(want!="" && n!=want) next; nc++
  if(!(n in st)){ P[++np]="error    " f ":" l ": register " n " — no such entry"; PN[np]=n; nerr++ }
  else if(st[n]=="closed"){ P[++np]="warning  " f ":" l ": register " n " — entry " n " is closed"; PN[np]=n; nw++ }
  if(lf[n]!=f){ by[n]=by[n] "\n       " f ": " l; lf[n]=f } else by[n]=by[n] ", " l
  if(!((f,n) in fe)){ fe[f,n]=1; if(!(f in fk)){ fo[++nf]=f; fk[f]=0 } FN[f, ++fk[f]]=n+0 }
  cited[n]=1; next }
$1=="U"{ if(want=="") T[++nt]=$2 ":" $3 ": " $4; next }
END{
  for(i=1;i<=ne;i++) if(ord[i] in cited) ncd++
  if(mode=="entry"){
    if(want in st) printf "%3s  %s%s\n", want, ti[want], (st[want]=="active"?"":" (" st[want] ")")
    else printf "entry %s: no such entry\n", want
    printf "%s\n", (want in cited) ? substr(by[want],2) : "       not cited"
    for(i=1;i<=np;i++) if(PN[i]==want) print "  " P[i]
    exit (mode=="check" && nerr>0)
  }
  if(mode!="check"){
    printf "register map — %s: %d entries; %d citations of %d entries in %d files\n", ENVIRON["SCOPE"], ne, nc, ncd, nf
    print ""; print "Entries" (ncd ? "" : ": none cited")
    for(i=1;i<=ne;i++){ n=ord[i]; if(!(n in cited)) continue
      printf "%3s  %s%s%s\n", n, ti[n], (st[n]=="active"?"":" (" st[n] ")"), by[n] }
    if(mode!="file"){
      u=""; for(i=1;i<=ne;i++) if(!(ord[i] in cited)) u=u (u==""?"":", ") ord[i]
      print ""; print "Not cited (listed, not a problem): " (u==""?"none":u)
      print ""; print "Files" (nf ? "" : ": none")
      for(i=1;i<=nf;i++){ f=fo[i]; k=fk[f]; for(a=1;a<=k;a++) L2[a]=FN[f,a]
        for(a=2;a<=k;a++){ v=L2[a]; for(b=a-1;b>=1 && L2[b]>v;b--) L2[b+1]=L2[b]; L2[b+1]=v }   # insertion sort: POSIX awk has no asort
        s=""; for(a=1;a<=k;a++) s=s (a>1?", ":"") L2[a]; print "  " f ": " s }
    }
    if(nt){ print ""; print "To triage: \"DEVIATIONS applied\" items that name no register entry (no number is guessed)"
      for(i=1;i<=nt;i++) print "  " T[i] }
  }
  if(np){ print ""; print "Problems"; for(i=1;i<=np;i++) print "  " P[i] }
  print ""; printf "%d error(s), %d warning(s)%s\n", nerr, nw, (mode=="check" ? "" : sprintf(", %d item(s) to triage", nt))
  exit (mode=="check" && nerr>0)
}
AWK

cmd_map() {
  local all=0 entry="" file="" check=0 only="" abs mode scope rc=0 entf r n t st _
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)   all=1; shift ;;
      --check) check=1; shift ;;
      --entry) [ $# -ge 2 ] || err "--entry requires a number"; entry="$2"; shift 2
               case "$entry" in ''|*[!0-9]*) err "--entry takes a whole number, not '$entry'" ;; esac
               entry="${entry#"${entry%%[!0]*}"}"; entry="${entry:-0}" ;;
      --file)  [ $# -ge 2 ] || err "--file requires a path"; file="$2"; shift 2 ;;
      *) err "usage: register map [--entry N | --file PATH] [--all] [--check]" ;;
    esac
  done
  [ -z "$entry" ] || [ -z "$file" ] || err "--entry and --file narrow the listing two different ways; pass one"
  parse
  if [ "$NB" -eq 0 ]; then
    printf 'register: %s has no <!-- register:begin --> marker — not yet migrated; nothing to map\n' "$FILE"; return 0
  fi
  if [ "${#PROBS[@]}" -gt 0 ]; then print_probs; err "map needs a valid register (run: register check)"; fi
  repo_root || err "map reads the repo's tracked files, and $FILE is not inside a git work tree"
  if [ -n "$file" ]; then
    # The named file is scanned whatever the scope: you asked for it by name.
    if [ -e "$file" ]; then abs="$(cd "$(dirname -- "$file")" && pwd -P)/$(basename -- "$file")"; else abs="$ROOT/$file"; fi
    only="$(git -C "$ROOT" ls-files --full-name --error-unmatch -- "$abs" 2>/dev/null)" || err "$file is not a file git tracks in $ROOT"
  fi
  collect "$all" "$only"
  entf="$(mktemp)" || err "cannot create a temp file"; TMPF+=("$entf")
  for r in "${ENTRIES_R[@]}"; do IFS=$'\037' read -r _ n t _ st _ <<<"$r"; printf '%s\037%s\037%s\n' "$n" "$st" "$t"; done > "$entf"
  if [ "$check" -eq 1 ]; then mode="check"; elif [ -n "$entry" ]; then mode="entry"; elif [ -n "$file" ]; then mode="file"; else mode="list"; fi
  if [ -n "$only" ]; then scope="$only"; elif [ "$all" -eq 1 ]; then scope="every tracked file (--all)"; else scope="live files (--all adds the register, the generated pages, docs/reference/, docs/AI/ and z-deprecated/)"; fi
  printf '%s' "$CREC${CREC:+$'\n'}" | MODE="$mode" ENTRY="$entry" ENTF="$entf" SCOPE="$scope" LC_ALL=C awk "$REPORT" "$entf" - || rc=$?
  # The page's citations: a warning when they no longer match the live files. Only the
  # default scope is what the page shows, so --all and --file skip this.
  if [ "$all" -eq 0 ] && [ -z "$only" ] && [ -f "$HTML" ]; then
    if [ "$(awk '/^\/\/ cites:begin/{s=1} s{print} /^\/\/ cites:end$/{s=0}' "$HTML")" != "$(cites_js "live files")" ]; then
      printf 'warning: the citations in %s are out of date — run: register render\n' "$HTML"
    fi
  fi
  return "$rc"
}

# ── render ────────────────────────────────────────────────────────────────────────────
cmd_render() {
  [ $# -eq 0 ] || err "usage: register render (it takes no options; 'register check' verifies without writing)"
  take_lock
  parse
  [ "$NB" -gt 0 ] || err "$FILE has no '<!-- register:begin' marker: not yet migrated, so there is no summary block to render (add the types and sources tables, the header lines and the marker pair first)"
  if [ "${#PROBS[@]}" -gt 0 ]; then print_probs; err "nothing written: render refuses a register that fails validation"; fi
  [ -d "$HTML" ] && err "$HTML exists as a DIRECTORY — clear it, then re-render"
  # The page's citations come from the live files at this moment; outside a git work tree
  # there are none to read, and the page says so.
  if repo_root; then collect 0 ""; CSCOPE="live files"; else CREC=""; CSCOPE=""; fi
  local treg="$FILE.tmp.$$" thtml="$HTML.tmp.$$" ncites
  TMPF+=("$treg" "$thtml" "$thtml.data")
  generate "$treg" "$thtml" || err "cannot write next to $FILE (directory unwritable or disk full?)"
  # An unchanged file is left untouched, so its mtime says when it last really changed.
  local done=""
  if cmp -s "$treg" "$FILE"; then rm -f "$treg"; else mv "$treg" "$FILE" || err "cannot replace $FILE (permissions?)"; done="the summary block"; fi
  if [ -f "$HTML" ] && cmp -s "$thtml" "$HTML"; then rm -f "$thtml"; else mv "$thtml" "$HTML" || err "cannot replace $HTML (permissions?)"; done="${done:+$done and }DEVIATIONS.html"; fi
  ncites="$(printf '%s\n' "$CREC" | grep -c '^C' || true)"
  printf '%s  (%d entries, %s citations%s)\n' "${done:+rendered $done}" "${#ENTRIES_R[@]}" "$ncites" "${CSCOPE:+ in the $CSCOPE}" | sed 's/^  /up to date  /'
  [ -n "$CSCOPE" ] || printf 'register: %s is not inside a git work tree, so the page lists no citations\n' "$FILE" >&2
}

# ── check ─────────────────────────────────────────────────────────────────────────────
cmd_check() {
  [ $# -eq 0 ] || err "usage: register check (it takes no options)"
  parse
  if [ "$NB" -eq 0 ]; then
    printf 'register: %s has no <!-- register:begin --> marker — not yet migrated; nothing to check\n' "$FILE"
    return 0
  fi
  if [ "${#PROBS[@]}" -gt 0 ]; then print_probs; return 1; fi
  TMPD="$(mktemp -d)" || err "cannot create a temp directory"
  CREC="" CSCOPE=""
  generate "$TMPD/DEVIATIONS.md" "$TMPD/DEVIATIONS.html" || err "cannot render into $TMPD (disk full?)"
  local stale=0
  # The pre-commit hook greps the token STALE to tell staleness from invalid input — keep it.
  if ! cmp -s "$TMPD/DEVIATIONS.md" "$FILE"; then printf 'register: the summary block in %s is STALE — run: register render\n' "$FILE" >&2; stale=1; fi
  # The citation block is left out: it follows the live files, not the register.
  if [ ! -f "$HTML" ] || ! cmp -s <(strip_cites "$TMPD/DEVIATIONS.html") <(strip_cites "$HTML"); then printf 'register: %s is STALE — run: register render\n' "$HTML" >&2; stale=1; fi
  [ "$stale" -eq 0 ] || return 1
  printf 'register: valid and up to date  (%d entries, %d types, %d sources)\n' "${#ENTRIES_R[@]}" "${#TYPES_R[@]}" "${#SOURCES_R[@]}"
}

# ── history ───────────────────────────────────────────────────────────────────────────
# One entry's history, read from git on demand (spec § 2): the committed versions in which
# its section changed, the commits whose messages name it, and the files that cite it.
# Nothing is recorded: git already holds the record. Read-only — no lock, no render, no
# write. The git walk repeats track's rather than sharing it, for the reason the page
# shell is (spec § 3). It needs no markers: a register's history predates them.
# HISTSEC: stdin is one version of the register → records for entry ENVIRON["HN"]:
#   X                                       the version has a numbered entry heading
#   T title                                 the entry's heading title
#   R header                                its header paragraph, wrapped lines joined
#   F type status original updated source   the header's fields, when they parse
#   B text                                  the rest of the section, newlines as 0x02
# The section runs from '## N. ' to the next '# ' or '## ' heading, fence-aware as the
# parser is, so a quoted example heading neither opens nor closes it.
read -r -d '' HISTSEC <<'AWK' || true
function trim(x){ gsub(/^[ \t]+|[ \t]+$/,"",x); return x }
function add(l,fenced){
  if(st==0){ if(l ~ /^[ \t]*$/ && !fenced) return
             if(!fenced && l ~ /^\*Type:\*/){ st=1; hdr=trim(l); return }
             st=2 }
  else if(st==1){ if(fenced || l ~ /^[ \t]*$/){ st=2; if(!fenced) return } else { hdr=hdr " " trim(l); return } }
  body=body l "\002"
}
function fields(txt,  lbl,f,rest,pos){
  split("Type Status Original Updated Source",lbl," ")
  rest=txt
  for(f=1;f<=5;f++){
    rest=trim(rest)
    if(index(rest,"*" lbl[f] ":*")!=1) return 0
    rest=substr(rest,length("*" lbl[f] ":*")+1)
    if(f<5){ pos=index(rest," · "); if(!pos) return 0; V[f]=trim(substr(rest,1,pos-1)); rest=substr(rest,pos+length(" · ")) }
    else V[f]=trim(rest)
  }
  return 1
}
BEGIN{ want=ENVIRON["HN"]+0 }
{ sub(/\r$/,"") }
/^ {0,3}(```|~~~)/ { t=($0 ~ /^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; if(on) add($0,1); next }
fc!="" { if(on) add($0,1); next }
/^##? / { on=0
  if($0 ~ /^## [1-9][0-9]*\. +[^ \t]/){ x=1; n=$0; sub(/^## /,"",n); sub(/\..*$/,"",n)
    if(n+0==want && !got){ got=1; on=1; st=0; ti=$0; sub(/^## [0-9]+\. +/,"",ti); ti=trim(ti) } }
  next }
on { add($0,0) }
END{
  if(x) print "X"
  if(!got) exit
  print "T\037" ti
  if(hdr!=""){ print "R\037" hdr; if(fields(hdr)) print "F\037" V[1] "\037" V[2] "\037" V[3] "\037" V[4] "\037" V[5] }
  sub(/^\002+/,"",body); sub(/\002+$/,"",body); print "B\037" body
}
AWK
hist_read(){  # $1 = HISTSEC's records → the E_* variables of cmd_history
  local k a b c d e
  E_X=0 E_ON=0 E_T="" E_R="" E_FOK=0 E_TY="" E_ST="" E_OG="" E_UP="" E_SO="" E_B=""
  while IFS=$'\037' read -r k a b c d e; do
    case "$k" in
      X) E_X=1 ;; T) E_ON=1 E_T=$a ;; R) E_R=$a ;; B) E_B=$a ;;
      F) E_FOK=1 E_TY=$a E_ST=$b E_OG=$c E_UP=$d E_SO=$e ;;
    esac
  done <<<"$1"
}
hist_keep(){ P_ON=$E_ON P_T=$E_T P_R=$E_R P_FOK=$E_FOK P_TY=$E_TY P_ST=$E_ST P_OG=$E_OG P_UP=$E_UP P_SO=$E_SO P_B=$E_B; }
hist_short(){ local s=$1; [ "${#s}" -le "$2" ] || s="${s:0:$(($2-1))}…"; printf '%s' "$s"; }
hist_lines(){ [ -n "$1" ] || { echo 0; return; }; local t="${1//[!$'\002']/}"; echo $(( ${#t} + 1 )); }
hist_hdr(){  # the current header, for a line: its fields, or the raw text when they do not parse
  if [ "$E_FOK" = 1 ]; then printf '%s · %s · %s · %s · %s' "$E_TY" "$E_ST" "$E_OG" "$(hist_short "$E_UP" 40)" "$(hist_short "$E_SO" 40)"
  else hist_short "$E_R" 80; fi
}
# What changed from the previous version (P_*) to this one (E_*), as one ' · '-joined phrase.
hist_delta(){
  local out=() n0
  if [ "$P_ON" = 0 ] && [ "$E_ON" = 1 ]; then
    if [ "$H_SEEN" = 1 ]; then out+=("entry back")
    elif [ "$H_NUMBERED" = 1 ]; then out+=("first appears as entry $HN")
    else out+=("first appears as entry $HN, in the file's first numbered version (the entry may be older)"); fi
    [ -z "$E_R" ] || out+=("header: $(hist_hdr)")
  elif [ "$P_ON" = 1 ] && [ "$E_ON" = 0 ]; then
    out+=("entry removed")
  elif [ "$E_ON" = 1 ]; then
    [ "$P_B" = "$E_B" ] || out+=("text changed ($(hist_lines "$P_B") → $(hist_lines "$E_B") lines)")
    [ "$P_T" = "$E_T" ] || out+=("title → \"$(hist_short "$E_T" 60)\"")
    if [ "$P_R" != "$E_R" ]; then
      if [ -z "$P_R" ]; then out+=("header added: $(hist_hdr)")
      elif [ -z "$E_R" ]; then out+=("header removed")
      elif [ "$P_FOK" = 1 ] && [ "$E_FOK" = 1 ]; then
        n0=${#out[@]}
        [ "$P_TY" = "$E_TY" ] || out+=("Type $P_TY → $E_TY")
        [ "$P_ST" = "$E_ST" ] || out+=("Status $P_ST → $E_ST")
        [ "$P_OG" = "$E_OG" ] || out+=("Original $P_OG → $E_OG")
        [ "$P_UP" = "$E_UP" ] || out+=("Updated $(hist_short "$P_UP" 40) → $(hist_short "$E_UP" 40)")
        [ "$P_SO" = "$E_SO" ] || out+=("Source → \"$(hist_short "$E_SO" 60)\"")
        [ "${#out[@]}" -gt "$n0" ] || out+=("header changed")   # the same fields, spaced differently
      else out+=("header changed"); fi
    fi
  fi
  [ "${#out[@]}" -gt 0 ] || return 0
  local IFS=$'\037'; local j="${out[*]}"; printf '%s' "${j//$'\037'/ · }"
}
cmd_history() {
  [ $# -eq 1 ] || err "usage: register history <N>"
  local HN="$1"
  case "$HN" in ''|*[!0-9]*) err "history takes an entry number, a whole number, not '$HN'" ;; esac
  HN="${HN#"${HN%%[!0]*}"}"
  [ -n "$HN" ] || err "entry numbers start at 1"
  repo_root || err "history reads git, and $FILE is not inside a git work tree"
  local shallow=""; [ "$(git -C "$ROOT" rev-parse --is-shallow-repository 2>/dev/null)" = true ] && shallow=1
  local E_X E_ON E_T E_R E_FOK E_TY E_ST E_OG E_UP E_SO E_B
  local P_ON=0 P_T="" P_R="" P_FOK=0 P_TY="" P_ST="" P_OG="" P_UP="" P_SO="" P_B=""
  local H_SEEN=0 H_NUMBERED=0 lines=() nv=0 lastc="" lastd="" c d p what

  # Versions: every commit that touched the file, oldest first. --follow keeps the history
  # across a rename, and git cannot combine it with --reverse, hence tac.
  while IFS=' ' read -r c d p; do
    hist_read "$(git -C "$ROOT" show "$c:$p" 2>/dev/null | HN="$HN" LC_ALL=C awk "$HISTSEC" || true)"
    what="$(hist_delta)"
    if [ -n "$what" ]; then lines+=("  $d  $c  $what"); nv=$((nv+1)); fi
    if [ "$E_ON" = 1 ]; then H_SEEN=1 lastc=$c lastd=$d; fi
    if [ "$E_X" = 1 ]; then H_NUMBERED=1; fi
    hist_keep
  done < <(git -C "$ROOT" log --follow --format='@@%h %cs' --name-only -- "$REGREL" 2>/dev/null \
             | awk '/^@@/{c=substr($0,3); next} NF && c!=""{print c, $0; c=""}' | tac)

  # The working copy: an 'uncommitted' last line when it differs from the last commit.
  hist_read "$(HN="$HN" LC_ALL=C awk "$HISTSEC" < "$FILE" || true)"
  what="$(hist_delta)"
  [ -z "$what" ] || lines+=("  uncommitted          $what")
  [ "$E_ON" = 1 ] || [ "$H_SEEN" = 1 ] || err "entry $HN has no '## $HN.' heading, now or in the history of $REGREL"

  # Commits whose messages name it, in the five forms that name the register, each matched
  # whole: never inside a longer number, and not where the number runs on into a date or a
  # version, as in map; in a list of numbers after one citation, only the first is named.
  # Each message is read with its lines joined, since a wrapped message often breaks a
  # citation in two, its word on one line and its number on the next; git log --grep
  # matches one line at a time. (This file is a live file in every vendor-derived repo, so
  # its own comments must never read as a citation: tests/register-map.sh scans it.)
  local commits nc=0
  commits="$(git -C "$ROOT" log --reverse --format='%cs%x1f%h%x1f%s%x1f%B%x1e' 2>/dev/null | LC_ALL=C awk -v RS='\036' -F'\037' -v n="$HN" '
      BEGIN{ re="[^a-z0-9_](register([ \t]+entr(y|ies))?[ \t]+|deviations(\\.md)?[ \t]*(§[ \t]*|#))0*" n "([^0-9.-]|[.-]([^0-9]|$)|$)" }
      NF>=4 { d=$1; sub(/^[\r\n]+/,"",d); m=" " tolower($4); gsub(/[\r\n]+/," ",m)
              if(m ~ re) print d "  " $2 "  " $3 }' || true)"
  [ -z "$commits" ] || nc=$(printf '%s\n' "$commits" | wc -l)

  # The files that cite it: what `register map --entry N --all` lists.
  collect 1 ""
  local cites; cites="$(printf '%s\n' "$CREC" | LC_ALL=C awk -F'\037' -v n="$HN" '
      $1=="C" && $4==n { if(!($2 in L)){ o[++k]=$2; L[$2]=$3 } else L[$2]=L[$2] ", " $3 }
      END{ for(i=1;i<=k;i++) printf "  %s: %s\n", o[i], L[o[i]] }')"

  if [ "$E_ON" = 1 ]; then
    printf '%s  %s' "$HN" "$E_T"; [ "$E_FOK" = 0 ] || printf '   (%s, %s)' "$E_TY" "$E_ST"; printf '\n'
  else printf '%s  (no longer in the register: last seen in %s, %s)\n' "$HN" "$lastc" "$lastd"; fi
  [ -z "$shallow" ] || printf '(a shallow clone: the history below is incomplete)\n'
  printf '\nVersions of the entry (%s)\n' "$nv"
  [ "${#lines[@]}" -eq 0 ] || printf '%s\n' "${lines[@]}"
  printf '\nCommits that name register %s (%s)\n' "$HN" "$nc"
  [ -z "$commits" ] || printf '%s\n' "$commits" | awk '{ if(length($0)>104) $0=substr($0,1,103) "…"; print "  " $0 }'
  if [ -z "$cites" ]; then printf '\nCited in no tracked file   (as register map --entry %s --all)\n' "$HN"
  else
    local nf; nf=$(printf '%s\n' "$cites" | wc -l)
    printf '\nCited in %d file%s   (as register map --entry %s --all)\n%s\n' "$nf" "$( [ "$nf" -eq 1 ] || echo s)" "$HN" "$cites"
  fi
}

# Requested help goes to stdout at exit 0; usage on error to stderr at exit 1 (B52).
usage() {
  cat <<'EOF'
register — checks and renders the deviations register (docs/official/DEVIATIONS.md)
  register check     # validate; exit 1 on problems, or with STALE when a render is due
  register render    # regenerate the summary block between the markers + DEVIATIONS.html
  register map [--entry N | --file PATH] [--all] [--check]
                     # where `register N` is cited (live files; --all for every tracked
                     # file); --check exits 1 on a citation of a missing entry
  register history <N>
                     # entry N's history from git: its versions, the commits that name
                     # it, the files that cite it
  (set REGISTER_FILE to work on another register; REGISTER_BASE resolves its Source paths elsewhere)
EOF
}

# ── dispatch ──────────────────────────────────────────────────────────────────────────
[ $# -ge 1 ] || { usage >&2; exit 1; }
sub="$1"; shift
case "$sub" in
  check)  resolve_file; cmd_check "$@" ;;
  render) resolve_file; cmd_render "$@" ;;
  map)    resolve_file; cmd_map "$@" ;;
  history) resolve_file; cmd_history "$@" ;;
  -h|--help|help) usage; exit 0 ;;
  *) err "unknown command '$sub' (check | render | map | history)" ;;
esac
