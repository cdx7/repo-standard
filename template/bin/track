#!/usr/bin/env bash
# Managed by repo-standard: read REPO-STANDARD.md at the repo root before editing, moving or
# deleting this file. sync replaces it from the standard.
# track — minimal tracker CLI for docs/dev-notes/tracker.md.
#   track add <bug|feature|doc|testing> "<name>" [--parent ID] [--status S] [--desc "…"]
#   track set-status <ID> <status>
#   track render [--check]             # regenerate tracker.html (--check: verify, write nothing)
# Names and --desc text are taken RAW: track escapes | itself, so pass unescaped text — a
# pre-escaped \| is stored as \\| and renders with its backslashes.
# Auto-maintains ID (per-category, nesting), Created (once), Status Changed (on change).
# Tracker resolution order: $TRACKER_FILE; the repo the INVOKED copy lives in
# ($0/../docs/dev-notes/tracker.md); CLAUDE_PROJECT_DIR or the cwd's git root;
# ./tracker.md as a last resort (announced on stderr).
# Portable: bash (>= 4) + awk + coreutils + date. No jq. Never commits (you gate that).
set -euo pipefail
# The state model below rides associative arrays — bash 4 machinery. Say so at the door
# (B86): claiming plain "bash" while stock macOS 3.2 died mid-script on an opaque
# `declare: -A: invalid option` was a fail-open portability lie. BASH_VERSINFO exists
# in bash 3, so the guard itself runs there.
[ "${BASH_VERSINFO[0]:-0}" -ge 4 ] || { printf 'track: requires bash >= 4 (stock macOS ships 3.2; brew install bash)\n' >&2; exit 1; }

# Temp files and the write lock are cleaned on ANY exit (B26): a failed render used to
# strand *.tmp.*/*.data.* files in the tree, and the ignore rules that caught them
# lived only in the standard's own .gitignore, never travelling to consumers.
TMPF=() LOCKDIR=""
cleanup(){
  [ "${#TMPF[@]}" -gt 0 ] && rm -f "${TMPF[@]}" 2>/dev/null
  [ -n "$LOCKDIR" ] && rmdir "$LOCKDIR" 2>/dev/null
  :
}
trap cleanup EXIT

# One writer at a time (B46): the read-modify-write around tracker.md silently loses
# rows and mints duplicate IDs under concurrency. mkdir is the portable atomic
# test-and-set; ~5s of retries outlasts any legitimate holder (writes are ms-scale).
take_lock(){
  local lock="$FILE.lock" i=0
  until mkdir "$lock" 2>/dev/null; do
    if [ ! -e "$lock" ] && [ ! -w "$(dirname -- "$FILE")" ]; then
      # mkdir failed with NO lock present: the directory itself is unwritable. Say
      # that, not "locked" — misattributing the failure is B50's exact disease.
      err "cannot create $FILE.lock — the tracker's directory is not writable"
    fi
    i=$((i+1))
    if [ "$i" -ge 50 ]; then
      err "tracker is locked by another track run ($FILE.lock exists — stale? rmdir it)"
    fi
    sleep 0.1
  done
  # Ours only NOW (B112): the EXIT trap fires on SIGINT/SIGTERM too, and assigning
  # LOCKDIR before the mkdir succeeded let an interrupted WAITER rmdir the HOLDER's
  # live lock — the next writer then raced the holder, B46's exact corruption.
  LOCKDIR="$lock"
}

# ── State model — the single source of truth (shared by set-status + render) ──────────
declare -A EMOJI=(
  [submitted]="📥" [researching]="🔍" [open]="⬜" [in-progress]="🔄" [blocked]="⛔"
  [testing]="🧪" [done]="✅" [cnr]="🤷" [dropped]="🗑️" [parked]="⏸️"
)
declare -A STATES=(
  [bug]="submitted researching open in-progress testing done blocked parked dropped cnr"
  [feature]="submitted researching open in-progress testing done blocked parked dropped"
  [doc]="open in-progress done blocked parked dropped"
  [testing]="open in-progress done blocked parked dropped"
)
declare -A DEFAULT=( [bug]="submitted" [feature]="open" [doc]="open" [testing]="open" )
# Happy-path order per category (the flow shown above each table); side states = STATES − FLOW.
declare -A FLOW=(
  [bug]="submitted researching open in-progress testing done"
  [feature]="submitted researching open in-progress testing done"
  [doc]="open in-progress done"
  [testing]="open in-progress done"
)

err() { printf 'track: %s\n' "$*" >&2; exit 1; }
in_set() { local x; for x in $2; do [ "$x" = "$1" ] && return 0; done; return 1; }
# JS double-quoted string literal from arbitrary text (escape \, ", and < to dodge
# </script>; a CR is a JS line terminator — raw, it is a SyntaxError that kills the
# whole page (B81's class), so it and tab are escaped too).
jsstr() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//</\\u003c}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}; printf '"%s"' "$s"; }

# category token (from `add`) → prefix + section heading + canonical category key
cat_meta() {
  case "$1" in
    bug|bugs)                 CAT=bug;     PREFIX=B; SECTION="Bugs" ;;
    feature|features|feat)    CAT=feature; PREFIX=F; SECTION="Features" ;;
    doc|docs|documentation)   CAT=doc;     PREFIX=D; SECTION="Documentation" ;;
    test|tests|testing)       CAT=testing; PREFIX=T; SECTION="Testing" ;;
    *) err "unknown category '$1' (use bug|feature|doc|testing)" ;;
  esac
}
# ID prefix letter → canonical category key (for set-status)
cat_of_id() {
  case "${1:0:1}" in
    B) echo bug ;; F) echo feature ;; D) echo doc ;; T) echo testing ;;
    *) err "unrecognized ID prefix in '$1'" ;;
  esac
}

# ── Locate the tracker file ───────────────────────────────────────────────────────────
resolve_file() {
  if [ -n "${TRACKER_FILE:-}" ]; then FILE="$TRACKER_FILE"
  else
    # The INVOKED copy names the repo (B19): `<target>/bin/track add …` must track
    # <target>, not whatever repo the caller happens to be standing in — resolving via
    # CLAUDE_PROJECT_DIR / the cwd's git root first routed a target's backlog into the
    # standard's own tracker during migration. $0 is deliberately NOT resolved through
    # symlinks: the standard's own bin/track is a symlink into template/, and chasing
    # it would name template/ instead of the repo.
    local sroot=""; sroot="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd || true)"
    local root; root="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
    if [ -n "$sroot" ] && [ -f "$sroot/docs/dev-notes/tracker.md" ]; then FILE="$sroot/docs/dev-notes/tracker.md"
    elif [ -n "$root" ] && [ -f "$root/docs/dev-notes/tracker.md" ]; then FILE="$root/docs/dev-notes/tracker.md"
    elif [ -f "./tracker.md" ]; then
      # cwd fallback, previously silent and undocumented (B62): kept for ad-hoc use,
      # but ANNOUNCED — quietly mutating whichever tracker.md the operator sits next
      # to is how edits land in the wrong repo's file.
      FILE="./tracker.md"
      printf 'track: using ./tracker.md (no canonical docs/dev-notes/tracker.md found; set TRACKER_FILE to silence this)\n' >&2
    else FILE="${root:+$root/docs/dev-notes/tracker.md}"; FILE="${FILE:-./tracker.md}"
    fi
  fi
  [ -f "$FILE" ] || err "tracker file not found: ${FILE:-<none>} (set TRACKER_FILE, or create tracker.md)"
  # A file with none of the four category headings is not a tracker (B147): pointed at
  # tracker.html by mistake, `track render` wrote an '(untitled)' 0-row page over the very
  # file it was reading, at exit 0 — a 2026-09-11 analysis did exactly that to an adopted
  # repo's tracker. Refused here, before any command reads further or writes. Fence-aware
  # like the parsers below: a heading quoted inside a code block does not make a tracker.
  awk '/^ {0,3}(```|~~~)/{t=($0 ~ /^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; next}
       fc!=""{next}
       /^## (Bugs|Features|Documentation|Testing)[[:space:]]*$/{f=1}
       END{exit f?0:1}' "$FILE" \
    || err "$FILE is not a tracker: it has no '## Bugs', '## Features', '## Documentation' or '## Testing' heading (check TRACKER_FILE)"
}

# ── ID-reuse protection (B47) ─────────────────────────────────────────────────────────
# Deleting a row used to FREE its number: the next mint rescanned surviving rows and
# handed the dead ID out again — silently inheriting every stale cross-reference to it.
# Two layers close that. Layer 1: the mint scans are DESCENDANT-aware — a dotted row
# (B94.2) reserves its leading 94 even when the B94 parent row is gone, and one level
# down a grandchild (B94.2.1) reserves its parent segment the same way. Layer 2: a
# `tracker-hwm` sidecar in the tracker's own directory records the highest ID ever
# MINTED per prefix — exactly two lines, a comment then "B<n> F<n> D<n> T<n>" — so
# deleting an ENTIRE family (no survivor for layer 1 to see) still can't recycle its
# number. A missing or unparseable sidecar is reseeded silently from the scans on the
# next top-level add (self-installing — deliberately no init/sync/skeleton coupling).
# Child IDs are NOT tracked in the sidecar: layer 1 covers a deleted parent with
# survivors, and a child family deleted WHOLE re-minting its index is the accepted
# residual — retire rows with dropped/cnr instead of deleting them.
scan_max() {  # $1 = prefix → highest surviving top-level number (0 if none), descendant-aware
  # The top-level segment is BOUNDED at the 9 digits hwm_get reads back, and a wider
  # one errs LOUDLY (convergence K7): unbounded, a mangled 19+-digit ID row — the kind
  # a bad find/replace leaves in a hand-editable file — flowed into bash's 64-bit mint
  # arithmetic, WRAPPED silently, and `track add` minted the same duplicate ID at
  # exit 0 twice in a row (the exact corruption B46/B47 exist to prevent), while also
  # writing a sidecar token wider than hwm_get's {1,9} accepts — layer 2 silently off
  # and the next add healing DOWNWARD. err in a $(…) exits the subshell; set -e makes
  # the parent die on the failed assignment, so every caller stops loudly. When the
  # damage is on ANOTHER prefix, hwm_write's scan can still err after the row insert —
  # the same mutate-before-refusal residue set-status/add already accept; the sidecar
  # reseeds on the next add after the row is repaired.
  local out
  out="$(awk -F'|' -v p="$1" '
    /^ {0,3}(```|~~~)/{t=($0~/^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; next} fc!=""{next}
    /^## (Bugs|Features|Documentation|Testing)[[:space:]]*$/{c=1;next} /^## /{c=0;next} c!=1{next}
    !/^\|/{next}
    {r=$2;gsub(/ /,"",r);
     if(r ~ ("^" p "[0-9]+$") || r ~ ("^" p "[0-9]+\\.")){
       num=substr(r,2); sub(/\..*$/,"",num)
       if(length(num)>9){bad=r; exit}   # exit still runs END — emit there
       x=int(num); if(x>m)m=x}}
    END{if(bad)print "!" bad; else print m+0}' "$FILE")"
  case "$out" in
    '!'*) err "tracker.md row ${out#!} has an out-of-range ID (top-level IDs are at most 9 digits) — repair that row, then retry" ;;
  esac
  printf '%s\n' "$out"
}
hwm_file() { printf '%s/tracker-hwm' "$(dirname -- "$FILE")"; }
hwm_get() {  # $1 = prefix → highest number recorded in the sidecar; 0 when absent/garbled
  local f v=""; f="$(hwm_file)"
  # A directory squatting on the sidecar name would swallow hwm_write's mv (GNU mv
  # relocates the tmp INTO it at exit 0), stranding tmp files there and silently
  # disabling layer 2 — B97's shape. Refuse HERE: every mint calls hwm_get before the
  # row insert, so the add fails before tracker.md is touched (hwm_write too).
  [ -d "$f" ] && err "$f exists as a DIRECTORY — clear it, then retry"
  if [ -f "$f" ]; then
    # gsub strips CRs so a CRLF checkout can't fail the LAST token's match and zero
    # that prefix's recorded high-water mark (B81's class — render strips \r too);
    # gsub on $0 re-splits the fields. The {1,9} bound keeps an absurd hand-edited
    # value on the documented unparseable→reseed path instead of wrapping mod 2^64.
    v="$(awk -v p="$1" 'NR==2{gsub(/\r/,""); for(i=1;i<=NF;i++) if($i ~ ("^" p "[0-9]{1,9}$")){print substr($i,2)+0; exit}}' "$f")"
  fi
  printf '%s' "${v:-0}"
}
hwm_write() {  # rewrite the sidecar, healing every prefix UPWARD from its scan — never down
  local f tmp p scan old line=""
  f="$(hwm_file)"; tmp="$f.tmp.$$"
  TMPF+=("$tmp")
  for p in B F D T; do
    scan="$(scan_max "$p")"; old="$(hwm_get "$p")"
    [ "$old" -gt "$scan" ] && scan="$old"
    line+="$p$scan "
  done
  { printf '# highest IDs ever minted by `track` — maintained by `track add`; do not hand-edit.\n'
    printf '%s\n' "${line% }"
  } > "$tmp" && mv "$tmp" "$f" || err "cannot write $f (directory unwritable or disk full?)"
}

# ── add ───────────────────────────────────────────────────────────────────────────────
cmd_add() {
  [ $# -ge 2 ] || err "usage: track add <category> \"<name>\" [--parent ID] [--status S] [--desc \"…\"]"
  take_lock
  cat_meta "$1"; shift
  local name="$1"; shift
  # A name that starts with '-' is almost always a flag that swallowed its position
  # (`track add bug --desc "..."` names the row '--desc' — B89). Checked BEFORE the
  # option loop so the error names the real mistake, not a downstream arg.
  case "$name" in -*) err "name '$name' looks like an option — pass the name (quoted) before any flags" ;; esac
  local parent="" status="" desc=""
  while [ $# -gt 0 ]; do
    # Each value is length-checked BEFORE `shift 2` (B34): a trailing option with no
    # value made shift 2 fail under set -e — exit 1 with zero output on either stream.
    case "$1" in
      --parent) [ $# -ge 2 ] || err "--parent requires a value"; parent="$2"; shift 2 ;;
      --status) [ $# -ge 2 ] || err "--status requires a value"; status="$2"; shift 2 ;;
      --desc)   [ $# -ge 2 ] || err "--desc requires a value";   desc="$2";   shift 2 ;;
      *) err "unknown option '$1'" ;;
    esac
  done
  [ -n "$name" ] || err "name is required"
  # Rows are single-line pipe-table records: a newline in free text shreds the table
  # silently (B21), and any other control char (a CR, a pasted 0x1f) corrupts the
  # render pipeline downstream (B85's class). Reject them all at the door. The newline
  # needs its own case-pattern — grep scans LINE-wise, so the one control character
  # that splits lines is precisely the one it can never see.
  local nl=$'\n'
  case "$name$desc" in *"$nl"*) err "name/--desc contain a newline — tracker rows are single-line" ;; esac
  if printf '%s%s' "$name" "$desc" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    err "name/--desc contain control characters (CR, tab, …) — tracker rows are single-line"
  fi

  status="${status:-${DEFAULT[$CAT]}}"
  in_set "$status" "${STATES[$CAT]}" || err "status '$status' is not valid for $CAT (allowed: ${STATES[$CAT]})"

  # Every parser below skips fenced code blocks (B84): a ```-quoted example row used
  # to count as a real item, inflating the next minted ID — a fenced B99 made the next
  # real bug B100 — and the insertion scan could land the new row INSIDE the fence.
  # Fence state is TYPE-AWARE (CommonMark: a fence closes only on its own delimiter):
  # a naive parity toggle re-opened on the inner ``` of a ~~~-wrapped example — the
  # canonical way documentation quotes a fenced row. Only COLUMN-0 table rows feed the
  # ID scans (B113): render and row insertion accept /^\|/ alone, and the scans MUST
  # match them — the old leading-whitespace anchor let a 1-3-space-indented '| B77 |'
  # in prose inflate minted IDs while the rendered page never showed it. The scans are
  # SECTION-scoped like render too (re-attack on B113): a column-0 pipe line outside
  # the four category sections (a '## Notes' table, say) is prose to render, so it
  # must be prose to the scans and to set-status as well.
  local id
  if [ -n "$parent" ]; then
    [ "${parent:0:1}" = "$PREFIX" ] || err "--parent $parent is not a $CAT (prefix $PREFIX)"
    # Bound the PARENT's own segments to what the mint itself writes (B129): K7/L7
    # closed the mint paths, but this path accepted the parent ID wholesale — so
    # `--parent B99999999999` minted B99999999999.1 at exit 0, tool-AUTHORING the
    # exact over-long row scan_max refuses loudly on the next top-level add, and a
    # mangled MIDDLE segment planted a row that broke every later sibling add (the
    # child scan's L7 err fires on it). Same shape as the mint: 1-9 digits per
    # dot-separated segment. Runs before the existence scan — a mangled row must be
    # REPAIRED (or retired via set-status dropped/cnr, which stays deliberately
    # unbounded as the documented repair path), never built upon.
    printf '%s' "${parent#"$PREFIX"}" | grep -qE '^[0-9]{1,9}(\.[0-9]{1,9})*$' \
      || err "--parent $parent has a malformed or out-of-range segment (ID segments are 1-9 digits) — repair that tracker row, then retry"
    awk -F'|' -v id="$parent" 'BEGIN{f=1}
      /^ {0,3}(```|~~~)/{t=($0~/^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; next} fc!=""{next}
      /^## (Bugs|Features|Documentation|Testing)[[:space:]]*$/{c=1;next} /^## /{c=0;next} c!=1{next}
      !/^\|/{next}
      {r=$2;gsub(/ /,"",r);if(r==id){f=0;exit}}END{exit f}' "$FILE" \
      || err "--parent $parent not found"
    # Grandchildren reserve their parent-level segment too (B47 layer 1): with B94.2
    # deleted but B94.2.1 surviving, the next child of B94 mints .3, never a second .2.
    # Same 9-digit bound + loud err as scan_max (convergence L7): the child path has
    # no bash arithmetic to wrap, but awk doubles PLATEAU past 2^53 — a mangled
    # 16+-digit child segment made m+1 == m, minting an ID that already exists at
    # exit 0, twice in a row (the B46/B47 duplicate class, one level down).
    local n; n=$(awk -F'|' -v par="$parent" '
      /^ {0,3}(```|~~~)/{t=($0~/^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; next} fc!=""{next}
      /^## (Bugs|Features|Documentation|Testing)[[:space:]]*$/{c=1;next} /^## /{c=0;next} c!=1{next}
      !/^\|/{next}
      {r=$2;gsub(/ /,"",r);
       if(substr(r,1,length(par)+1)==par"."){rest=substr(r,length(par)+2); if(rest ~ /^[0-9]+$/ || rest ~ /^[0-9]+\./){
         num=rest; sub(/\..*$/,"",num)
         if(length(num)>9){bad=r; exit}   # exit still runs END — emit there
         x=int(num); if(x>m)m=x}}}
      END{if(bad)print "!" bad; else print m+1}' "$FILE")
    case "$n" in
      '!'*) err "tracker.md row ${n#!} has an out-of-range child index (child indices are at most 9 digits) — repair that row, then retry" ;;
    esac
    # Same +1 boundary as the top-level mint: never write a child index the scan
    # above would refuse on the NEXT add.
    [ "$n" -le 999999999 ] || err "next child index of $parent would exceed 9 digits — repair or archive the tracker before minting more"
    id="$parent.$n"
  else
    # Mint = max(descendant-aware scan, sidecar high-water mark) + 1 (B47): the scan
    # alone re-minted a deleted family's number, resurrecting its stale references.
    local n scan hwm
    scan=$(scan_max "$PREFIX"); hwm=$(hwm_get "$PREFIX")
    n=$(( (scan > hwm ? scan : hwm) + 1 ))
    # Never mint what hwm_get cannot read back (convergence K7): both feeders are
    # bounded at 9 digits, so only the +1 at 999999999 itself can cross the line —
    # refuse it rather than write a sidecar token layer 2 would silently drop.
    [ "$n" -le 999999999 ] || err "next $CAT ID would exceed 9 digits — repair or archive the tracker before minting more"
    id=$(printf '%s%02d' "$PREFIX" "$n")
  fi

  # escape pipes so free text can't break the table
  name="${name//|/\\|}"; desc="${desc//|/\\|}"
  local today; today="$(date +%F)"
  local row="| $id | ${EMOJI[$status]} $status | $today | $today | $name | $desc |"

  local tmp="$FILE.tmp.$$" rc=0
  TMPF+=("$tmp")
  # pass the row via ENVIRON, NOT awk -v: -v applies backslash-escape processing, which
  # would turn our escaped \| back into a bare | and break the table. (don't "simplify")
  ROW="$row" awk -v heading="## $SECTION" '
      function fstep(l){ if(l ~ /^ {0,3}(```|~~~)/){ t=(l ~ /^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; return 1 } return 0 }
      { lines[NR]=$0 }
      END{
        fc=""; h=0
        for(i=1;i<=NR;i++){
          if(fstep(lines[i])) continue
          if(fc=="" && lines[i] ~ ("^" heading "[[:space:]]*$")){ h=i; break }
        }
        if(h==0){ exit 3 }
        e=NR+1; fc=""
        for(i=h+1;i<=NR;i++){
          if(fstep(lines[i])) continue
          if(fc=="" && lines[i] ~ /^## /){ e=i; break }
        }
        # np counts pipe rows between heading and next section; zero means even the
        # table HEADER is gone — inserting there would emit a headerless row that
        # renders as broken markdown while every check stays green (B93). Refuse.
        ins=h; np=0; fc=""
        for(i=h+1;i<e;i++){
          if(fstep(lines[i])) continue
          if(fc=="" && lines[i] ~ /^\|/){ ins=i; np++ }
        }
        if(np==0){ exit 4 }
        for(i=1;i<=NR;i++){ print lines[i]; if(i==ins) print ENVIRON["ROW"] }
      }' "$FILE" > "$tmp" || rc=$?
  # Distinct failures get distinct messages (B50): a failed redirect into an
  # unwritable directory used to be reported as "section not found".
  case "$rc" in
    0) mv "$tmp" "$FILE" || err "cannot replace $FILE (permissions?)"
       printf 'added %s  (%s, %s)\n' "$id" "$status" "$today"
       # The new row is in the file now, so hwm_write's scans see the freshly minted
       # number, and every OTHER prefix heals upward in the same pass (B47). Top-level
       # adds only — child IDs are never tracked in the sidecar.
       [ -n "$parent" ] || hwm_write ;;
    3) err "section '## $SECTION' not found in $FILE" ;;
    4) err "section '## $SECTION' has no table header — restore the '| ID | Status | … |' header row first" ;;
    *) err "cannot write next to $FILE (exit $rc — directory unwritable or disk full?)" ;;
  esac
  [ -n "${TRACK_NO_RENDER:-}" ] || cmd_render   # keep tracker.html in sync
}

# ── set-status ────────────────────────────────────────────────────────────────────────
cmd_set_status() {
  [ $# -eq 2 ] || err "usage: track set-status <ID> <status>"
  take_lock
  local id="$1" status="$2"
  local cat; cat="$(cat_of_id "$id")"
  in_set "$status" "${STATES[$cat]}" || err "status '$status' is not valid for $cat (allowed: ${STATES[$cat]})"

  # Fence-skips (B84, type-aware) + COLUMN-0 row anchor + SECTION scope (B113,
  # matching render): a quoted example row must neither answer the lookup nor be
  # rewritten, and a PROSE line containing '| B77 |' — indented, or column-0 outside
  # the four category sections — must never be mutated while the CLI prints success.
  local cur; cur=$(awk -F'|' -v id="$id" '
    /^ {0,3}(```|~~~)/{t=($0~/^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; next} fc!=""{next}
    /^## (Bugs|Features|Documentation|Testing)[[:space:]]*$/{c=1;next} /^## /{c=0;next} c!=1{next}
    !/^\|/{next}
    {r=$2;gsub(/ /,"",r); if(r==id){s=$3;gsub(/^ +| +$/,"",s);k=split(s,a," ");print a[k];exit}}' "$FILE")
  [ -n "$cur" ] || err "ID '$id' not found"
  if [ "$cur" = "$status" ]; then printf '%s already %s\n' "$id" "$status"; return 0; fi

  local today; today="$(date +%F)"
  local tmp="$FILE.tmp.$$"
  TMPF+=("$tmp")
  awk -F'|' -v OFS='|' -v id="$id" -v cell=" ${EMOJI[$status]} $status " -v when=" $today " '
    /^ {0,3}(```|~~~)/{ t=($0~/^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; print; next }
    fc!="" { print; next }
    /^## (Bugs|Features|Documentation|Testing)[[:space:]]*$/{ c=1; print; next }
    /^## /{ c=0; print; next }
    c!=1 { print; next }
    !/^\|/ { print; next }
    { r=$2; gsub(/ /,"",r); if(r==id){ $3=cell; $5=when } print }' "$FILE" > "$tmp" \
    && mv "$tmp" "$FILE" || err "cannot write next to $FILE (directory unwritable or disk full?)"
  printf '%s: %s → %s  (Status Changed = %s)\n' "$id" "$cur" "$status" "$today"
  [ -n "${TRACK_NO_RENDER:-}" ] || cmd_render   # keep tracker.html in sync
}

# ── render ────────────────────────────────────────────────────────────────────────────
cmd_render() {
  local out tmp datafile rows_js emoji_js model_js n s c a f repo check=0 us
  # Validate arguments (B77): a mistyped '--cehck' used to fall through to a FULL
  # render — destroying the staleness evidence it was asked to report on.
  if [ $# -gt 0 ]; then
    { [ "$1" = "--check" ] && [ $# -eq 1 ]; } || err "usage: track render [--check]"
    check=1
  fi
  # Refuse a raw US byte outright (B85): the row pipeline below uses 0x1f as its field
  # separator, so a raw one already sitting in a cell silently shifts every later field
  # while render prints success. `add` rejects control chars at the door; this catches
  # the hand-edit/paste path — and auto-render, --check, verify, and the pre-commit
  # hook all funnel through here, so none of them can launder such a file.
  us="$(awk 'index($0,"\037"){print NR; exit}' "$FILE")"
  [ -z "$us" ] || err "$FILE line $us: raw 0x1f (US) byte — the render pipeline uses it as its field separator; remove it first"
  out="$(dirname "$FILE")/tracker.html"
  # A directory-shaped destination would swallow the mv (tracker.html/tracker.html.tmp.*)
  # while render printed success and --check reported STALE forever — B97's shape.
  [ -d "$out" ] && err "$out exists as a DIRECTORY — clear it, then re-render"
  tmp="$out.tmp.$$"; datafile="$FILE.data.$$"
  TMPF+=("$tmp" "$datafile")

  # Repo name for the page title. Taken from tracker.md's own H1 ("# tracker — <name>")
  # so the rendered page is named by its CONTENT, not by where it happens to sit — that
  # keeps a render of a staged/temp copy byte-identical to the worktree one (the
  # pre-commit guard relies on this), which is also why every FALLBACK is content-
  # derived: a path-derived title would break that byte-identity (B22). The em dash is
  # matched as an ALTERNATION, never inside a bracket expression — a multibyte char in
  # [] matches its individual BYTES, which made extraction locale-dependent (B22). A
  # CRLF file's stray \r is stripped before it lands raw in the <title> (B91).
  repo="$(awk 'NR>20{exit}
    /^ {0,3}(```|~~~)/{t=($0~/^ {0,3}~~~/)?"t":"b"; if(fc=="")fc=t; else if(fc==t)fc=""; next} fc!=""{next}
    /^#[[:space:]]*tracker/ {
      line=$0; sub(/\r$/,"",line)
      sub(/^#[[:space:]]*tracker[[:space:]]*/,"",line)
      sub(/^(—|-)[[:space:]]*/,"",line)
      if(line!=""){ print line; exit }
    }' "$FILE")"
  if [ -z "$repo" ]; then
    repo="$(awk 'NR==1 && /^#[[:space:]]/ { line=$0; sub(/\r$/,"",line); sub(/^#[[:space:]]*/,"",line); print line; exit }' "$FILE")"
  fi
  [ -n "$repo" ] || repo="(untitled)"
  # HTML-escape via sed, not ${var//…} (B48): bash 5.2's patsub_replacement expands &
  # in the replacement as "the match", so ${repo//</&lt;} yielded '<lt;' — the raw
  # angle bracket it was written to remove. sed's replacement language is stable.
  repo="$(printf '%s' "$repo" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"   # inert in HTML

  # Rows: parse tracker.md, emit US(0x1f)-delimited records (no quoting needed), JS-escape in bash.
  rows_js="const ROWS = ["$'\n'
  while IFS=$'\037' read -r id cat status created changed name desc; do
    [ -n "$id" ] || continue
    rows_js+="  {id:$(jsstr "$id"),cat:$(jsstr "$cat"),status:$(jsstr "$status"),created:$(jsstr "$created"),changed:$(jsstr "$changed"),name:$(jsstr "$name"),desc:$(jsstr "$desc")},"$'\n'
  done < <(awk '
    function trim(x){ gsub(/^ +| +$/,"",x); return x }
    { sub(/\r$/,"") }                              # CRLF file: a raw CR in a field is a JS SyntaxError downstream (B81)
    /^ {0,3}(```|~~~)/ {                           # fenced example rows are not items (B84, type-aware)
      t=($0 ~ /^ {0,3}~~~/)?"t":"b"
      if(fence=="")fence=t; else if(fence==t)fence=""
      next
    }
    fence!=""          { next }
    /^## Bugs[[:space:]]*$/          { c="bug";     next }
    /^## Features[[:space:]]*$/      { c="feature"; next }
    /^## Documentation[[:space:]]*$/ { c="doc";     next }
    /^## Testing[[:space:]]*$/       { c="testing"; next }
    /^## /                           { c="";        next }
    {
      if(c=="" || $0 !~ /^\|/) next
      line=$0; gsub(/\\\|/,"\001",line)              # protect escaped pipes before splitting
      split(line, f, "|")
      id=trim(f[2]); if(id=="ID" || id ~ /^:?-+:?$/) next
      s=trim(f[3]); k=split(s,arr," "); st=arr[k]
      nm=trim(f[6]); ds=trim(f[7])
      gsub(/\001/,"|",nm); gsub(/\001/,"|",ds)        # restore as literal pipes
      printf "%s%c%s%c%s%c%s%c%s%c%s%c%s\n", id,31,c,31,st,31,trim(f[4]),31,trim(f[5]),31,nm,31,ds
    }' "$FILE")
  rows_js+="];"

  emoji_js="const EMOJI = {"
  for s in submitted researching open in-progress blocked testing done cnr dropped parked; do emoji_js+="\"$s\":\"${EMOJI[$s]}\","; done
  emoji_js+="};"

  model_js="const MODEL = {"$'\n'
  for c in bug feature doc testing; do
    a=""; for s in ${STATES[$c]}; do a+="\"$s\","; done
    f=""; for s in ${FLOW[$c]};   do f+="\"$s\","; done
    model_js+="  \"$c\":{allowed:[$a],flow:[$f],def:\"${DEFAULT[$c]}\"},"$'\n'
  done
  model_js+="};"

  { printf '%s\n' "$rows_js"; printf '%s\n' "$emoji_js"; printf '%s\n' "$model_js"; } > "$datafile"

  # Two substitutions into the static template: the data block, and the repo name.
  # BOTH ride ENVIRON: awk -v applies backslash processing, so a path with a backslash
  # arrived mangled and the data block was emitted EMPTY while render printed success
  # (B49). The name is spliced with index/substr — gsub()'s replacement expands & as
  # "the match" (B48), so an &-bearing name leaked __REPO__ into the page.
  REPO="$repo" DF="$datafile" awk '
      /^\/\/__DATA__\/\/$/{ while((getline l < ENVIRON["DF"])>0) print l; close(ENVIRON["DF"]); next }
      { out=""; rest=$0
        while((i=index(rest,"__REPO__"))>0){ out=out substr(rest,1,i-1) ENVIRON["REPO"]; rest=substr(rest,i+8) }
        print out rest }' > "$tmp" <<'HTML'
