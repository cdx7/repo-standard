<script>
  const COLOR={submitted:"#8b5cf6",researching:"#06b6d4",open:"#8a94a6","in-progress":"#3b82f6",blocked:"#ef4444",testing:"#f59e0b",done:"#22c55e",cnr:"#f97316",dropped:"#6b7280",parked:"#64748b"};
  const ORDER=["submitted","researching","open","in-progress","blocked","testing","done","cnr","dropped","parked"];
  const CATS=[{key:"bug",label:"Bugs",idp:"B##"},{key:"feature",label:"Features",idp:"F##"},{key:"doc",label:"Documentation",idp:"D##"},{key:"testing",label:"Testing",idp:"T##"}];
  const state={q:"",statuses:new Set(),secStatuses:{},sortKey:"id",dir:1,expanded:new Set(),collapsed:new Set()};
  const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

  function natCmp(a,b){const ax=String(a).match(/(\d+|\D+)/g)||[],bx=String(b).match(/(\d+|\D+)/g)||[];const n=Math.max(ax.length,bx.length);for(let i=0;i<n;i++){const p=ax[i],q=bx[i];if(p===undefined)return -1;if(q===undefined)return 1;const pn=/^\d+$/.test(p),qn=/^\d+$/.test(q);if(pn&&qn){const d=parseInt(p)-parseInt(q);if(d)return d}else if(p!==q)return p<q?-1:1}return 0}
  const oi=s=>{const i=ORDER.indexOf(s);return i<0?ORDER.length:i};   // unknown statuses sort LAST, not first (B82)
  function cmp(a,b){let r;if(state.sortKey==="id")r=natCmp(a.id,b.id);else if(state.sortKey==="status")r=(oi(a.status)-oi(b.status))||natCmp(a.id,b.id);else if(state.sortKey==="name")r=a.name.toLowerCase()<b.name.toLowerCase()?-1:a.name.toLowerCase()>b.name.toLowerCase()?1:0;else{const ka=a[state.sortKey]||"",kb=b[state.sortKey]||"";r=(ka<kb?-1:ka>kb?1:0)||natCmp(a.id,b.id)}return r*state.dir}
  function match(r){if(state.statuses.size&&!state.statuses.has(r.status))return false;const ss=state.secStatuses[r.cat];if(ss&&ss.size&&!ss.has(r.status))return false;if(state.q){const q=state.q.toLowerCase();if(!(r.id.toLowerCase().includes(q)||r.name.toLowerCase().includes(q)||(r.desc||"").toLowerCase().includes(q)))return false}return true}
  const depth=id=>(id.match(/\./g)||[]).length;
  function ancestors(id){const p=[];let s=id;while(s.includes(".")){s=s.slice(0,s.lastIndexOf("."));p.push(s)}return p}
  const pill=st=>`<span class="pill" style="--sc:${COLOR[st]||'#888'}"><span class="dot"></span><span class="em">${EMOJI[st]||''}</span>${esc(st)}</span>`;

  function flowFor(key){
    const m=MODEL[key];if(!m)return"";
    const rows=ROWS.filter(r=>r.cat===key);const cnt=s=>rows.filter(r=>r.status===s).length;
    const ss=state.secStatuses[key];
    // data-st is ATTRIBUTE context (B123): an unknown, hand-mangled status word rides
    // into it raw — esc() it like every other interpolation, or a quote breaks out.
    const chip=(s,muted)=>{const n=cnt(s),on=!!ss&&ss.has(s);return `<button class="fchip${muted?' muted':''}${n?' has':''}${on?' on':''}" style="--sc:${COLOR[s]||'#888'}" data-cat="${esc(key)}" data-st="${esc(s)}" aria-pressed="${on}"><span class="fdot"></span>${EMOJI[s]||''} ${esc(s)}${n?`<span class="fn">${n}</span>`:''}</button>`};
    const flow=m.flow.map(s=>chip(s,false)).join(`<span class="farr">→</span>`);
    // Side states beyond the happy path, PLUS any status word the model doesn't know
    // (B82) — hand-mangled rows stay per-section filterable instead of invisible.
    const side=m.allowed.filter(s=>!m.flow.includes(s))
      .concat([...new Set(rows.map(r=>r.status))].filter(s=>!m.allowed.includes(s)).sort());
    const sideHtml=side.length?`<span class="fsep">+</span>`+side.map(s=>chip(s,true)).join(""):"";
    const clear=(ss&&ss.size)?`<button class="btn fclear" data-cat="${key}">clear</button>`:"";
    return `<div class="flow"><span class="flbl">flow</span>${flow}${sideHtml}${clear}</div>`;
  }

  function renderChips(){
    const counts={};ROWS.forEach(r=>counts[r.status]=(counts[r.status]||0)+1);
    // Unknown/hand-mangled status words get chips too, after the known ones (B82):
    // they used to be unfilterable, uncounted, and invisible in the strip.
    const present=ORDER.filter(k=>counts[k]).concat(Object.keys(counts).filter(k=>!ORDER.includes(k)).sort());
    const el=document.getElementById("chips");
    el.innerHTML='<span class="lbl">Status</span>'+present.map(k=>{const on=state.statuses.has(k);
      return `<button class="chip ${on?'on':''}" style="--sc:${COLOR[k]||'#888'}" data-st="${esc(k)}" aria-pressed="${on}"><span class="dot"></span>${EMOJI[k]||''} ${esc(k)} <span class="n">${counts[k]}</span></button>`}).join("")
      +(state.statuses.size?`<button class="btn" id="clearSt" style="margin-left:4px">clear</button>`:"");
    el.querySelectorAll(".chip").forEach(c=>c.onclick=()=>{const k=c.dataset.st;state.statuses.has(k)?state.statuses.delete(k):state.statuses.add(k);render()});
    const cl=document.getElementById("clearSt");if(cl)cl.onclick=()=>{state.statuses.clear();render()};
  }

  function renderSections(){
    const root=document.getElementById("sections");let shown=0,html="";
    for(const cat of CATS){
      const all=ROWS.filter(r=>r.cat===cat.key);const rows=all.filter(match).sort(cmp);shown+=rows.length;
      const collapsed=state.collapsed.has(cat.key);const cols=["id","status","created","changed","name"];
      const map={id:"ID",status:"Status",created:"Created",changed:"Status Changed",name:"Name"};
      const cls={id:"c-id",status:"c-st",created:"c-cr",changed:"c-ch",name:"c-name"};
      const th=c=>{const act=state.sortKey===c;return `<th class="${cls[c]} ${act?'act':''}" data-k="${c}">${map[c]}<span class="ar">${act?(state.dir>0?'▲':'▼'):''}</span></th>`};
      let body;
      // An empty SECTION and a filtered-out section are different facts (B92): a
      // pristine page must not blame "the current filter" it doesn't have.
      if(rows.length===0)body=`<tr><td colspan="5"><div class="empty">${all.length===0?`No ${esc(cat.label.toLowerCase())} recorded yet.`:`No ${esc(cat.label.toLowerCase())} match the current filter.`}</div></td></tr>`;
      else body=rows.map(r=>{const open=state.expanded.has(r.id),d=depth(r.id),hasDetail=!!r.desc||d>0;
        const det=open?`<tr class="detail"><td colspan="5"><div class="box">${r.desc?esc(r.desc):'<span class="none">No description recorded.</span>'}<div class="meta"><span><b>id</b> ${esc(r.id)}</span>${d>0?`<span><b>part of</b> ${ancestors(r.id).map(esc).join(" ← ")}</span>`:''}<span><b>created</b> ${esc(r.created)}</span><span><b>status changed</b> ${esc(r.changed)}</span></div></div></td></tr>`:"";
        return `<tr class="row ${open?'open':''}" data-id="${esc(r.id)}" tabindex="0" role="button" aria-expanded="${open}"><td class="c-id"><span class="idv"><span class="depth">${'· '.repeat(d)}</span>${esc(r.id)}</span></td><td class="c-st">${pill(r.status)}</td><td class="c-cr">${esc(r.created)}</td><td class="c-ch">${esc(r.changed)}</td><td><div class="name"><span class="exp ${hasDetail?'has-detail':''}">▶</span><span>${esc(r.name)}</span></div></td></tr>${det}`}).join("");
      html+=`<section class="section ${collapsed?'collapsed':''}" data-cat="${cat.key}"><div class="sec-head" role="button" tabindex="0" aria-expanded="${!collapsed}"><span class="chev">▼</span><h2>${esc(cat.label)}</h2><span class="sec-idp">${esc(cat.idp)}</span><span class="sec-n">${rows.length}${rows.length!==all.length?` / ${all.length}`:''}</span></div><div class="sec-body">${flowFor(cat.key)}<table><thead><tr>${cols.map(th).join("")}</tr></thead><tbody>${body}</tbody></table></div></section>`;
    }
    root.innerHTML=html;document.getElementById("count").textContent=`${shown} of ${ROWS.length} shown`;
    root.querySelectorAll(".sec-head").forEach(h=>{const cat=h.parentElement.dataset.cat;const t=()=>{state.collapsed.has(cat)?state.collapsed.delete(cat):state.collapsed.add(cat);render()};h.onclick=t;h.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();t()}}});
    root.querySelectorAll("thead th").forEach(t=>t.onclick=()=>{const k=t.dataset.k;if(state.sortKey===k)state.dir*=-1;else{state.sortKey=k;state.dir=1}syncSort();render()});
    root.querySelectorAll("tr.row").forEach(tr=>{const id=tr.dataset.id;const t=()=>{state.expanded.has(id)?state.expanded.delete(id):state.expanded.add(id);render()};tr.onclick=t;tr.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();t()}}});
    root.querySelectorAll(".fchip").forEach(c=>c.onclick=()=>{const ss=state.secStatuses[c.dataset.cat]||(state.secStatuses[c.dataset.cat]=new Set());const s=c.dataset.st;ss.has(s)?ss.delete(s):ss.add(s);renderSections()});
    root.querySelectorAll(".fclear").forEach(b=>b.onclick=()=>{delete state.secStatuses[b.dataset.cat];renderSections()});
  }
  function syncSort(){document.getElementById("sortKey").value=state.sortKey;document.getElementById("dir").textContent=state.dir>0?"↑ asc":"↓ desc"}
  function render(){renderChips();renderSections()}
  document.getElementById("q").addEventListener("input",e=>{state.q=e.target.value;renderSections()});
  document.getElementById("sortKey").addEventListener("change",e=>{state.sortKey=e.target.value;state.dir=1;syncSort();render()});
  document.getElementById("dir").addEventListener("click",()=>{state.dir*=-1;syncSort();render()});
  // Judge "all open?" against the VISIBLE rows only (B83): state.expanded keeps ids
  // that later filters hid, and counting those made the button collapse (or no-op)
  // when every visible row was actually closed.
  document.getElementById("expandAll").addEventListener("click",()=>{const vis=ROWS.filter(match);const allOpen=vis.length>0&&vis.every(r=>state.expanded.has(r.id));if(allOpen){vis.forEach(r=>state.expanded.delete(r.id));document.getElementById("expandAll").textContent="Expand all"}else{vis.forEach(r=>state.expanded.add(r.id));document.getElementById("expandAll").textContent="Collapse all"}renderSections()});
  document.getElementById("foot").innerHTML=`<strong>tracker.html</strong> — generated from <code>tracker.md</code> by <code>track render</code>. ${ROWS.length} items. Read-only; edit via <code>track add</code> / <code>track set-status</code>, then re-render.`;
  syncSort();render();
</script>
</body>
</html>
HTML

  n=$(printf '%s' "$rows_js" | grep -c '{id:' || true)
  if [ "$check" -eq 1 ]; then
    if [ -f "$out" ] && cmp -s "$tmp" "$out"; then
      rm -f "$tmp" "$datafile"; printf 'tracker.html up to date (%s items)\n' "$n"; return 0
    fi
    # The pre-commit hook greps the token STALE to tell genuine staleness from refusals — keep it.
    rm -f "$tmp" "$datafile"; printf 'tracker.html is STALE — run: track render\n' >&2; return 1
  fi
  mv "$tmp" "$out"; rm -f "$datafile"
  printf 'rendered %s  (%s items)\n' "$out" "$n"
}

# Requested help goes to stdout at exit 0; only usage-on-error goes to stderr at
# exit 1 (B52 — init, sync and verify all exit 0 for an explicit help request).
usage() {
  cat <<'EOF'
track — minimal tracker CLI
  track add <bug|feature|doc|testing> "<name>" [--parent ID] [--status S] [--desc "…"]
  track set-status <ID> <status>
  track render [--check]                        # regenerate tracker.html (--check: verify current, exit 1 if stale)
  (add / set-status auto-render; set TRACK_NO_RENDER=1 to skip)
  (names and --desc are taken raw: track escapes | itself, so do not pre-escape it)
EOF
}

# ── dispatch ──────────────────────────────────────────────────────────────────────────
[ $# -ge 1 ] || { usage >&2; exit 1; }
sub="$1"; shift
case "$sub" in
  add)         resolve_file; cmd_add "$@" ;;
  set-status)  resolve_file; cmd_set_status "$@" ;;
  render)      resolve_file; cmd_render "$@" ;;
  -h|--help|help) usage; exit 0 ;;
  *) err "unknown command '$sub' (add | set-status | render)" ;;
esac
